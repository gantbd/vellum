; Conditional adopted baseline and scoped extension laws only.
; No native/provider/profile truth or implementation refinement is established.
(set-logic ALL)
(set-option :timeout 10000)
(declare-const removed (_ BitVec 3))
(declare-const pins (_ BitVec 3))
(declare-const closure (_ BitVec 3))
(echo "BASE-HISTORY-PINS")
(push)
(assert (= (bvand closure pins) #b000))
(assert (= removed closure))
(check-sat)
(assert (not (= (bvand removed pins) #b000)))
(check-sat)
(pop)
(declare-const open Bool)
(declare-const sameOrigin Bool)
(declare-const samePlan Bool)
(declare-const sameParticipants Bool)
(declare-const compatible Bool)
(declare-const capacity Bool)
(define-fun join () Bool (and open sameOrigin samePlan sameParticipants compatible capacity))
(echo "BASE-GROUP-ISOLATION")
(push)
(assert join)
(check-sat)
(assert (or (not sameOrigin) (not samePlan) (not sameParticipants)))
(check-sat)
(pop)
(declare-const causal Bool)
(declare-const uncontested Bool)
(declare-const providerValid Bool)
(declare-const pinned Bool)
(define-fun progress () Bool (and causal uncontested providerValid (not pinned)))
(echo "BASE-CAUSAL-PROGRESSION")
(push)
(assert progress)
(check-sat)
(assert (or pinned (not causal) (not uncontested) (not providerValid)))
(check-sat)
(pop)
(declare-const textA String)
(declare-const textB String)
(declare-const bomA Bool)
(declare-const bomB Bool)
(define-fun mark () String (str.from_code 65279))
(define-fun domain ((text String) (bom Bool)) Bool (or bom (not (str.prefixof mark text))))
(define-fun encode ((text String) (bom Bool)) String (ite bom (str.++ mark text) text))
(echo "BASE-BOM-INJECTIVE")
(push)
(assert (and (domain textA bomA) (domain textB bomB) (= (encode textA bomA) (encode textB bomB))))
(check-sat)
(assert (or (not (= textA textB)) (not (= bomA bomB))))
(check-sat)
(pop)
(declare-const parent Int)
(declare-const requested Int)
(define-fun child () Int (ite (< parent requested) parent requested))
(echo "BASE-INHERITED-BUDGET")
(push)
(assert (and (>= parent 0) (>= requested 0)))
(check-sat)
(assert (not (and (<= 0 child parent) (<= child requested))))
(check-sat)
(pop)
(declare-const held Int)
(declare-const newSlots Int)
(declare-const cap Int)
(define-fun canActivate () Bool (and (<= 0 held cap) (<= 0 newSlots (- cap held))))
(echo "BASE-RETAINED-CONTEXT")
(push)
(assert canActivate)
(check-sat)
(assert (> (+ held newSlots) cap))
(check-sat)
(pop)
(declare-const sameSession Bool)
(declare-const currentSource Bool)
(declare-const grant Bool)
(declare-const cancelled Bool)
(define-fun commit () Bool (and sameSession currentSource grant (not cancelled)))
(echo "BASE-NATIVE-SESSION")
(push)
(assert cancelled)
(check-sat)
(assert commit)
(check-sat)
(pop)
(declare-const acknowledged Bool)
(declare-const unknown Bool)
(define-fun cut () Bool (and acknowledged currentSource grant (not unknown)))
(echo "BASE-CUT-GATE")
(push)
(assert cut)
(check-sat)
(assert (or unknown (not acknowledged) (not currentSource) (not grant)))
(check-sat)
(pop)
(declare-const lost Int)
(declare-const maximum Int)
(define-fun nextLoss () Int (ite (< lost maximum) (+ lost 1) maximum))
(echo "BASE-LOSS-SATURATION")
(push)
(assert (and (> maximum 0) (<= 0 lost maximum)))
(check-sat)
(assert (not (and (<= lost nextLoss maximum) (> nextLoss 0))))
(check-sat)
(pop)
(declare-const complete Bool)
(declare-const scopeCurrent Bool)
(define-fun semanticAllowed () Bool (and grant currentSource complete scopeCurrent))
(echo "BASE-COMPLETE-EVIDENCE")
(push)
(assert semanticAllowed)
(check-sat)
(assert (not complete))
(check-sat)
(pop)
(declare-const preference (_ BitVec 4))
(declare-const restriction (_ BitVec 4))
(define-fun effective () (_ BitVec 4) (bvand preference restriction))
(echo "BASE-CONFIG-NONAMPLIFICATION")
(push)
(check-sat)
(assert (not (= (bvand effective restriction) effective)))
(check-sat)
(pop)
(declare-const required (_ BitVec 4))
(declare-const supplied (_ BitVec 4))
(declare-const knownViolation Bool)
(define-fun acceptable () Bool (and (= (bvand required supplied) required) (not knownViolation)))
(echo "BASE-ACCEPTANCE-GATE")
(push)
(assert acceptable)
(check-sat)
(assert (or knownViolation (not (= (bvand required supplied) required))))
(check-sat)
(pop)
(echo "BASE-BOM-AMBIGUITY-CONTROL")
(push)
(assert (and (= textA "x") bomA (= textB (str.++ mark "x")) (not bomB)
  (= (encode textA bomA) (encode textB bomB))))
(check-sat)
(pop)
(echo "BASE-DELIVERY-ORDER-CONTROL")
(push)
(assert (and (not causal) providerValid (not pinned)))
(check-sat)
(pop)
(echo "BASE-LOSS-WRAP-CONTROL")
(push)
(assert (and (> maximum 0) (= lost maximum) (= (mod (+ lost 1) (+ maximum 1)) 0)))
(check-sat)
(pop)
(echo "BASE-PARTIAL-COMPLETENESS-CONTROL")
(push)
(assert (and grant currentSource scopeCurrent (not complete)))
(check-sat)
(pop)

; §23.2.1 optional diagnostic queue. Logical integers and supplied grants;
; this is not installed instrumentation, host clock truth or physical allocation.
(declare-const diagMaximum Int)
(declare-const diagCount Int)
(declare-const diagAmount Int)
(declare-const diagActual Int)
(declare-const diagExact Bool)
(define-fun diagDomain () Bool
 (and (<= 0 diagCount diagMaximum 9007199254740991)
      (<= 0 diagAmount 9007199254740991)))
(define-fun diagNext () Int
 (ite (> diagAmount (- diagMaximum diagCount)) diagMaximum (+ diagCount diagAmount)))
(define-fun diagNextExact () Bool
 (and diagExact (<= diagAmount (- diagMaximum diagCount))))
(echo "BASE-DIAG-COUNTER-RANGE")
(push)
(assert diagDomain)
(check-sat)
(assert (not (<= diagCount diagNext diagMaximum)))
(check-sat)
(pop)
(echo "BASE-DIAG-COUNTER-EXACT")
(push)
(assert (and diagDomain (>= diagActual 0)
 (= diagCount (ite (> diagActual diagMaximum) diagMaximum diagActual))
 (= diagExact (<= diagActual diagMaximum))))
(check-sat)
(assert (not (and
 (= diagNext (ite (> (+ diagActual diagAmount) diagMaximum) diagMaximum (+ diagActual diagAmount)))
 (= diagNextExact (<= (+ diagActual diagAmount) diagMaximum)))))
(check-sat)
(pop)
(echo "BASE-DIAG-ZERO-CAPACITY")
(push)
(assert (and diagDomain (= diagMaximum 0) (> diagAmount 0)))
(check-sat)
(assert (not (and (= diagNext 0) (not diagNextExact))))
(check-sat)
(pop)
(declare-const diagUsed Int)
(declare-const diagCapacity Int)
(echo "BASE-DIAG-BYTE-ADMISSION")
(push)
(assert (and diagDomain (<= 0 diagUsed diagCapacity 9007199254740991)
 (<= diagAmount (- diagCapacity diagUsed))))
(check-sat)
(assert (not (<= 0 (+ diagUsed diagAmount) diagCapacity 9007199254740991)))
(check-sat)
(pop)
(declare-const diagHead Int)
(declare-const diagLength Int)
(declare-const diagRoom Bool)
(define-fun diagAfterHead () Int diagHead)
(define-fun diagAfterLength () Int (ite diagRoom (+ diagLength 1) diagLength))
(echo "BASE-DIAG-DROP-FRAME")
(push)
(assert (and (>= diagLength 0) (not diagRoom)))
(check-sat)
(assert (not (and (= diagAfterHead diagHead) (= diagAfterLength diagLength))))
(check-sat)
(pop)
(declare-const diagRelease Bool)
(declare-const diagFits Bool)
(declare-const diagDrained Int)
(declare-const diagTake Int)
(define-fun diagCommitDrain () Bool (and diagRelease diagFits))
(define-fun diagDrainLength () Int (ite diagCommitDrain (- diagLength diagTake) diagLength))
(define-fun diagDrainCount () Int (ite diagCommitDrain (+ diagDrained diagTake) diagDrained))
(echo "BASE-DIAG-DRAIN-REFUSAL")
(push)
(assert (and (<= 0 diagTake diagLength) (>= diagDrained 0) (not diagCommitDrain)))
(check-sat)
(assert (not (and (= diagDrainLength diagLength) (= diagDrainCount diagDrained))))
(check-sat)
(pop)
(declare-const diagAge Int)
(declare-const diagTick Int)
(define-fun diagNextAge () Int (ite (>= diagTick diagAge) 0 (- diagAge diagTick)))
(echo "BASE-DIAG-AGE-RANK")
(push)
(assert (and (> diagAge 0) (> diagTick 0)))
(check-sat)
(assert (not (and (>= diagNextAge 0) (< diagNextAge diagAge))))
(check-sat)
(pop)
(declare-const diagGeneration Int)
(declare-const diagGenerationLimit Int)
(echo "BASE-DIAG-RESET-BOUNDARY")
(push)
(assert (and (<= 1 diagGeneration) (< diagGeneration diagGenerationLimit 9007199254740992)))
(check-sat)
(assert (not (and (not (= (+ diagGeneration 1) diagGeneration))
 (<= (+ diagGeneration 1) diagGenerationLimit))))
(check-sat)
(pop)
(echo "BASE-DIAG-WRAP-CONTROL")
(push)
(assert (and (> diagMaximum 0) (= diagCount diagMaximum)
 (= (mod (+ diagCount 1) (+ diagMaximum 1)) 0)))
(check-sat)
(pop)
(declare-const diagCapturedGrant Bool)
(echo "BASE-DIAG-OLD-GRANT-CONTROL")
(push)
(assert (and diagCapturedGrant (not diagRelease)
 (not (and diagCapturedGrant diagRelease))))
(check-sat)
(pop)

; §23.2.2 owned local F26 drain. Abstract ordinals/facts, not exposed wire epochs.
(declare-const drainPhase Int)
(declare-const drainCalls Int)
(declare-const drainService Bool)
(declare-const drainDispatch Bool)
(define-fun drainTurn () Bool (and (= drainPhase 1) drainService))
(define-fun drainExec () Bool (and drainTurn drainDispatch))
(define-fun drainNextCalls () Int (ite drainExec (+ drainCalls 1) drainCalls))
(define-fun drainNextPhase () Int (ite drainTurn 2 drainPhase))
(echo "BASE-DRAIN-AT-MOST-ONCE")
(push)
(assert (and (<= 0 drainPhase 2) (<= 0 drainCalls 1)
 (=> (> drainCalls 0) (= drainPhase 2))))
(check-sat)
(assert (not (and (<= 0 drainNextCalls 1)
 (=> (> drainNextCalls 0) (= drainNextPhase 2)))))
(check-sat)
(pop)
(declare-const drainFact Int)
(define-fun drainStoppedFact () Int (ite (= drainPhase 2) drainFact 0))
(echo "BASE-DRAIN-TERMINAL-KNOWLEDGE")
(push)
(assert (and (= drainPhase 2) (or (= drainFact 1) (= drainFact 2))))
(check-sat)
(assert (not (= drainStoppedFact drainFact)))
(check-sat)
(pop)
(declare-const drainCapturedGrant Bool)
(declare-const drainCurrentGrant Bool)
(declare-const drainRetained Bool)
(declare-const drainCapturedGeneration Int)
(declare-const drainCurrentGeneration Int)
(declare-const drainBatchBytes Int)
(declare-const drainActualBound Int)
(declare-const drainReservedBatch Int)
(declare-const drainReservedResult Int)
(declare-const drainEnvelopeBytes Int)
(define-fun drainRelease () Bool
 (and drainCapturedGrant drainCurrentGrant drainRetained
 (= drainCapturedGeneration drainCurrentGeneration)))
(echo "BASE-DRAIN-RESULT-CEILING")
(push)
(assert (and drainRelease (<= 0 drainBatchBytes drainActualBound drainReservedBatch)
 (>= drainEnvelopeBytes 0) (>= drainReservedResult (+ drainActualBound drainEnvelopeBytes))))
(check-sat)
(assert (not (and drainCurrentGrant
 (= drainCapturedGeneration drainCurrentGeneration)
 (<= (+ drainBatchBytes drainEnvelopeBytes) drainReservedResult))))
(check-sat)
(pop)
(declare-const drainHeld Bool)
(declare-const drainConsumers Int)
(declare-const drainOwnerDischarged Bool)
(define-fun drainParentRetire () Bool (and (not drainHeld) drainOwnerDischarged))
(echo "BASE-DRAIN-QUEUE-HOLD")
(push)
(assert (and (> drainConsumers 0) drainHeld drainOwnerDischarged))
(check-sat)
(assert drainParentRetire)
(check-sat)
(pop)
(declare-const drainIssued Int)
(declare-const drainIssueLimit Int)
(declare-const drainSlots Int)
(define-fun drainAfterRetireIssued () Int drainIssued)
(define-fun drainIssueRoom () Bool (< drainAfterRetireIssued drainIssueLimit))
(echo "BASE-DRAIN-LIFETIME-ISSUANCE")
(push)
(assert (and (<= 0 drainIssued drainIssueLimit 9007199254740991)
 (= drainIssued drainIssueLimit) (= drainSlots 0)))
(check-sat)
(assert drainIssueRoom)
(check-sat)
(pop)
(declare-const drainSameIntent Bool)
(define-fun drainObserveExisting () Bool (and (not (= drainPhase 0)) drainSameIntent))
(define-fun drainAfterRetryPhase () Int (ite (= drainPhase 0) 1 drainPhase))
(echo "BASE-DRAIN-RETRY-FRAME")
(push)
(assert (and (<= 0 drainPhase 2) drainObserveExisting))
(check-sat)
(assert (not (= drainAfterRetryPhase drainPhase)))
(check-sat)
(pop)
(echo "BASE-DRAIN-REDRAIN-CONTROL")
(push)
(assert (and (= drainPhase 2) (= drainCalls 1) (>= drainPhase 1)
 (> (+ drainCalls 1) 1)))
(check-sat)
(pop)
(echo "BASE-DRAIN-PARENT-FLAG-CONTROL")
(push)
(assert (and (> drainConsumers 0) drainHeld drainOwnerDischarged
 (not drainParentRetire)))
(check-sat)
(pop)

; Exact scoped source predicates: two-range arithmetic and a finite 7-cell
; permission-set abstraction, not a proof of host grants or all native execution.
(declare-const scLo Int)
(declare-const scHi Int)
(declare-const scPoint Int)
(declare-const scFirst Int)
(declare-const scLast Int)
(define-fun scSite () Bool (and (<= scFirst scPoint) (<= scPoint scLast)))
(echo "BASE-SCOPE-INSERTION-INDEPENDENCE")
(push)
(assert (and (<= 0 scLo scPoint scHi) (< scLo scHi)
 (<= 0 scFirst scLast) (< scPoint scFirst)))
(check-sat)
(assert scSite)
(check-sat)
(pop)
(echo "BASE-SCOPE-SITE-ENDPOINTS")
(push)
(assert (and (<= 0 scFirst scLast) (or (= scPoint scFirst) (= scPoint scLast))))
(check-sat)
(assert (not scSite))
(check-sat)
(pop)
(declare-const scA0 Int)
(declare-const scA1 Int)
(declare-const scB0 Int)
(declare-const scB1 Int)
(define-fun scRanges () Bool (and (<= 0 scA0) (< scA0 scA1)
 (<= scA1 scB0) (< scB0 scB1) (< scLo scHi)))
(define-fun scCovered () Bool (or
 (and (<= scA0 scLo) (<= scHi scA1))
 (and (<= scB0 scLo) (<= scHi scB1))
 (and (= scA1 scB0) (<= scA0 scLo) (<= scHi scB1))))
(echo "BASE-SCOPE-HOLE-REFUSAL")
(push)
(assert (and scRanges (<= scA0 scLo) (< scLo scA1 scB0 scHi) (<= scHi scB1)))
(check-sat)
(assert scCovered)
(check-sat)
(pop)
(echo "BASE-SCOPE-TOUCHING-COVERAGE")
(push)
(assert (and scRanges (= scA1 scB0) (= scLo scA0) (= scHi scB1)))
(check-sat)
(assert (not scCovered))
(check-sat)
(pop)
(declare-const scGrant Bool)
(declare-const scFound Bool)
(declare-const scAllCovered Bool)
(declare-const scCurrent Int)
(declare-const scExpected Int)
(declare-const scWriteExpected Int)
(define-fun scRevision () Bool (and (>= scCurrent 0)
 (= scCurrent scExpected) (= scExpected scWriteExpected)))
(define-fun scPublish () Bool (and scGrant scFound scAllCovered scRevision))
(echo "BASE-SCOPE-NO-GRANT")
(push)
(assert (and (not scGrant) scFound scAllCovered scRevision))
(check-sat)
(assert scPublish)
(check-sat)
(pop)
(echo "BASE-SCOPE-REVISION-FENCE")
(push)
(assert (and scGrant scFound scAllCovered (>= scCurrent 0)
 (or (not (= scCurrent scExpected)) (not (= scExpected scWriteExpected)))))
(check-sat)
(assert scPublish)
(check-sat)
(pop)
(echo "BASE-SCOPE-MISSING-NOT-EMPTY")
(push)
(assert (and scGrant (not scFound) scAllCovered scRevision))
(check-sat)
(assert scPublish)
(check-sat)
(pop)
(declare-const scCaller (_ BitVec 7))
(declare-const scPolicy (_ BitVec 7))
(define-fun scEffective () (_ BitVec 7) (bvand scCaller scPolicy))
(echo "BASE-SCOPE-MEET-NONAMPLIFICATION")
(push)
(check-sat)
(assert (not (and (= (bvand scEffective (bvnot scCaller)) #b0000000)
 (= (bvand scEffective (bvnot scPolicy)) #b0000000))))
(check-sat)
(pop)
(echo "BASE-SCOPE-HULL-WIDENING-CONTROL")
(push)
(assert (and scRanges (<= scA0 scLo) (< scLo scA1 scB0 scHi)
 (<= scHi scB1) (not scCovered)))
(check-sat)
(pop)
(echo "BASE-SCOPE-IMPLICIT-SITES-CONTROL")
(push)
(assert (and (<= 0 scLo scPoint scHi) (< scLo scHi)
 (<= 0 scFirst scLast) (< scPoint scFirst) (not scSite)))
(check-sat)
(pop)

; §13.9.1 retained identity and exact-integer floors. Host facts remain premises.
(declare-const memBodyFloor Int)
(declare-const memTargetFloor Int)
(declare-const memCurrentVersion Int)
(declare-const memCapturedVersion Int)
(declare-const memMaximum Int)
(define-fun memDomain () Bool
  (and (>= memBodyFloor 1) (>= memTargetFloor 1)
       (<= memBodyFloor memMaximum) (<= memTargetFloor memMaximum)
       (<= memMaximum 9007199254740991)))
(define-fun memRoom () Bool
  (and (< memBodyFloor memMaximum) (< memTargetFloor memMaximum)))
(echo "BASE-MEM-FRESH-VERSIONS")
(push)
(assert (and memDomain memRoom))
(check-sat)
(assert (not (and (> (+ memBodyFloor 1) memBodyFloor)
                  (> (+ memTargetFloor 1) memTargetFloor)
                  (<= (+ memBodyFloor 1) memMaximum)
                  (<= (+ memTargetFloor 1) memMaximum))))
(check-sat)
(pop)
(echo "BASE-MEM-STALE-COMMAND")
(push)
(assert (and memDomain memRoom (>= memCapturedVersion 1)
             (<= memCapturedVersion memBodyFloor)))
(check-sat)
(assert (= memCapturedVersion (+ memBodyFloor 1)))
(check-sat)
(pop)
(echo "BASE-MEM-RESTORATION-EXHAUSTION")
(push)
(assert (and memDomain (= memBodyFloor memMaximum)))
(check-sat)
(assert memRoom)
(check-sat)
(pop)
(echo "BASE-MEM-FLOOR-PRESERVATION")
(push)
(assert (and memDomain (>= memCurrentVersion memBodyFloor)
             (< memCurrentVersion memMaximum)))
(check-sat)
(assert (not (> (+ memCurrentVersion 1) memBodyFloor)))
(check-sat)
(pop)
(declare-const memPhase Int)
(declare-const memRemove Bool)
(declare-const memRestore Bool)
(declare-const memRetire Bool)
(define-fun memNextPhase () Int
  (ite (and (= memPhase 0) memRemove) 1
    (ite (and (= memPhase 1) memRestore) 0
      (ite (and (= memPhase 1) memRetire) 2 memPhase))))
(echo "BASE-MEM-RETIRED-ABSORPTION")
(push)
(assert (= memPhase 2))
(check-sat)
(assert (not (= memNextPhase 2)))
(check-sat)
(pop)
(declare-const memCurrentAuthority Bool)
(declare-const memRetentionReleased Bool)
(declare-const memDeliveryDrained Bool)
(declare-const memSessionReleased Bool)
(declare-const memAuthoredDisposition Bool)
(declare-const memHistoryReleased Bool)
(declare-const memJournalPresent Bool)
(define-fun memRetirementAllowed () Bool
  (and (= memPhase 1) memCurrentAuthority memRetentionReleased memDeliveryDrained
       memSessionReleased memAuthoredDisposition memHistoryReleased (not memJournalPresent)))
(echo "BASE-MEM-RETIREMENT-OBLIGATIONS")
(push)
(assert memRetirementAllowed)
(check-sat)
(assert (or (not (= memPhase 1)) (not memCurrentAuthority)
            (not memRetentionReleased) (not memDeliveryDrained) (not memSessionReleased)
            (not memAuthoredDisposition) (not memHistoryReleased) memJournalPresent))
(check-sat)
(pop)
(echo "BASE-MEM-OLD-VERSION-CONTROL")
(push)
(assert (and memDomain (= memCapturedVersion memBodyFloor)
             (= memCurrentVersion memBodyFloor)))
(check-sat)
(pop)
(echo "BASE-MEM-RETIRED-REUSE-CONTROL")
(push)
(assert (and (= memPhase 2) memRestore
             (= (ite memRestore 0 memPhase) 0)))
(check-sat)
(pop)

; Selected engine settings transition algebra, not JavaScript/host refinement.
(declare-const settingMax Int)
(declare-const settingPublication Int)
(declare-const settingGeneration Int)
(declare-const settingLayer Int)
(declare-const settingExpected Int)
(declare-const settingDomain Int)
(declare-const settingChanged Bool)
(declare-const settingEffective Bool)
(declare-const settingValid Bool)
(define-fun settingWellFormed () Bool
 (and (> settingMax 0) (<= 0 settingPublication settingMax)
      (<= 1 settingGeneration settingMax) (<= 1 settingLayer settingMax)
      (<= 1 settingDomain settingMax) (=> settingEffective settingChanged)))
(define-fun settingCapacity () Bool
 (or (not settingChanged)
     (and (< settingPublication settingMax) (< settingGeneration settingMax)
          (< settingLayer settingMax) (or (not settingEffective) (< settingDomain settingMax)))))
(define-fun settingAllowed () Bool
 (and settingWellFormed settingValid (= settingExpected settingLayer) settingCapacity))
(define-fun settingPublished () Bool (and settingAllowed settingChanged))
(define-fun settingNextPublication () Int (ite settingPublished (+ settingPublication 1) settingPublication))
(define-fun settingNextGeneration () Int (ite settingPublished (+ settingGeneration 1) settingGeneration))
(define-fun settingNextLayer () Int (ite settingPublished (+ settingLayer 1) settingLayer))
(define-fun settingNextDomain () Int (ite (and settingPublished settingEffective) (+ settingDomain 1) settingDomain))
(echo "BASE-SETTING-COUNTER-RANGE")
(push)
(assert settingWellFormed)
(check-sat)
(assert (not (and (<= 0 settingNextPublication settingMax)
                 (<= 1 settingNextGeneration settingMax)
                 (<= 1 settingNextLayer settingMax) (<= 1 settingNextDomain settingMax))))
(check-sat)
(pop)
(echo "BASE-SETTING-STALE-LAYER")
(push)
(assert settingAllowed)
(check-sat)
(assert (not (= settingExpected settingLayer)))
(check-sat)
(pop)
(echo "BASE-SETTING-ORIGIN-FRAME")
(push)
(assert (and settingAllowed settingChanged (not settingEffective)))
(check-sat)
(assert (or (not (= settingNextDomain settingDomain))
            (not (= settingNextGeneration (+ settingGeneration 1)))))
(check-sat)
(pop)
(declare-const settingParent Int)
(declare-const settingReserve Int)
(declare-const settingBudget Int)
(echo "BASE-SETTING-PARENT-BUDGET")
(push)
(assert (and (<= 0 settingParent) (<= 0 settingReserve)
             (<= (+ settingParent settingReserve) settingBudget)))
(check-sat)
(assert (or (< (+ settingParent settingReserve) settingParent)
            (> (+ settingParent settingReserve) settingBudget)))
(check-sat)
(pop)
(declare-const settingIssued Int)
(declare-const settingIssueMax Int)
(declare-const settingHeld Int)
(declare-const settingHoldMax Int)
(declare-const settingAcquire Bool)
(declare-const settingRelease Bool)
(define-fun settingIssue () Bool
 (and settingAcquire (< settingIssued settingIssueMax) (< settingHeld settingHoldMax)))
(define-fun settingNextIssued () Int (ite settingIssue (+ settingIssued 1) settingIssued))
(echo "BASE-SETTING-ISSUANCE-NONREFUND")
(push)
(assert (and (<= 0 settingIssued settingIssueMax) (<= 0 settingHeld settingHoldMax)))
(check-sat)
(assert (or (< settingNextIssued settingIssued) (> settingNextIssued settingIssueMax)
            (and settingRelease (= settingIssued settingIssueMax) settingIssue)))
(check-sat)
(pop)
(declare-const settingClosed Bool)
(declare-const settingRetire Bool)
(declare-const settingPlans Int)
(define-fun settingNextClosed () Bool
 (or settingClosed (and settingRetire (= settingHeld 0) (= settingPlans 0))))
(echo "BASE-SETTING-CLOSED-ABSORPTION")
(push)
(assert settingClosed)
(check-sat)
(assert (and (not settingNextClosed) settingAcquire))
(check-sat)
(pop)
(echo "BASE-SETTING-OVERFLOW-CONTROL")
(push)
(assert (and settingWellFormed settingValid settingChanged
             (= settingPublication settingMax)
             (> (+ settingPublication 1) settingMax)))
(check-sat)
(pop)
(echo "BASE-SETTING-ORIGIN-INVALIDATION-CONTROL")
(push)
(assert (and settingAllowed settingChanged (not settingEffective)
             (> (ite settingPublished (+ settingDomain 1) settingDomain) settingDomain)))
(check-sat)
(pop)

; Conditional workspace-read guard and generation step laws. Native producer
; tests separately exercise these steps; the equations do not prove refinement.
(declare-const wsReadBase Int)
(declare-const wsReadExpected Int)
(declare-const wsReadCurrent Int)
(declare-const wsReadOtherBase Int)
(declare-const wsReadOtherCurrent Int)
(declare-const wsReadPrepared Bool)
(declare-const wsReadScope Bool)
(declare-const wsReadPermission Bool)
(declare-const wsReadIdentity Bool)
(declare-const wsReadLive Bool)
(declare-const wsReadInitialMember Bool)
(declare-const wsReadIntermediateMember Bool)
(declare-const wsReadFinalMember Bool)
(define-fun wsReadRange () Bool
 (and (<= 0 wsReadExpected 9007199254740991)
      (<= 0 wsReadCurrent 9007199254740991)))
(define-fun wsReadEligible () Bool
 (and wsReadRange wsReadPrepared wsReadScope wsReadPermission wsReadIdentity
      wsReadLive (= wsReadExpected wsReadCurrent)))
(define-fun wsReadValueOnlyEligible () Bool
 (and wsReadRange wsReadPrepared wsReadScope wsReadPermission wsReadIdentity
      wsReadLive (= wsReadInitialMember wsReadFinalMember)))
(define-fun wsReadABA () Bool
 (and (<= 0 wsReadBase 9007199254740989)
      (= wsReadExpected wsReadBase) (= wsReadCurrent (+ wsReadBase 2))
      (not wsReadInitialMember) wsReadIntermediateMember (not wsReadFinalMember)
      wsReadPrepared wsReadScope wsReadPermission wsReadIdentity wsReadLive))
(echo "BASE-WSREAD-CURRENT")
(push)
(assert wsReadEligible)
(check-sat)
(assert (or (not wsReadScope) (not wsReadPermission) (not wsReadIdentity)
            (not wsReadLive) (not (= wsReadExpected wsReadCurrent))))
(check-sat)
(pop)
(echo "BASE-WSREAD-ABA-FENCE")
(push)
(assert wsReadABA)
(check-sat)
(assert wsReadEligible)
(check-sat)
(pop)
(echo "BASE-WSREAD-DISJOINT-FRAME")
(push)
(assert (and wsReadRange (= wsReadExpected wsReadCurrent)
             (<= 0 wsReadOtherBase 9007199254740990)
             (= wsReadOtherCurrent (+ wsReadOtherBase 1))
             wsReadPrepared wsReadScope wsReadPermission wsReadIdentity wsReadLive))
(check-sat)
(assert (not wsReadEligible))
(check-sat)
(pop)
(echo "BASE-WSREAD-VALUE-ONLY-CONTROL")
(push)
(assert (and wsReadABA wsReadValueOnlyEligible (not wsReadEligible)))
(check-sat)
(pop)

; Conditional candidate and observed-loss laws. Not JavaScript/Rust refinement,
; real authorization, provider truth, global closure or physical accounting.
(declare-datatypes () ((DefState (defState
 (defLayers (Array Int Int)) (defTargets Int)
 (defSchema Int) (defRestriction Int) (defAssociation Int)
 (defDomain Int) (defGeneration Int)))))
(define-fun defVersion ((v Int)) Bool (<= 1 v 9007199254740991))
(define-fun defValid ((s DefState)) Bool
 (and (defVersion (defSchema s)) (defVersion (defRestriction s))
      (defVersion (defAssociation s)) (defVersion (defDomain s))
      (defVersion (defGeneration s))))
(define-fun defChanged ((s Bool) (r Bool) (a Bool)) Bool (or s r a))
(define-fun defEligible ((old DefState) (s Bool) (r Bool) (a Bool) (effective Bool)
 (versions Bool) (base Bool) (sg Bool) (rg Bool) (ag Bool)) Bool
 (and (defValid old) base (=> effective (defChanged s r a))
      (=> s sg) (=> r rg) (=> a ag)
      (=> (defChanged s r a) (and versions (< (defGeneration old) 9007199254740991)))
      (=> s (< (defSchema old) 9007199254740991))
      (=> r (< (defRestriction old) 9007199254740991))
      (=> a (< (defAssociation old) 9007199254740991))
      (=> effective (< (defDomain old) 9007199254740991))))
(define-fun defStep ((old DefState) (target Int) (s Bool) (r Bool) (a Bool)
 (effective Bool) (versions Bool) (base Bool) (sg Bool) (rg Bool) (ag Bool)) DefState
 (ite (and (defEligible old s r a effective versions base sg rg ag) (defChanged s r a))
  (defState (defLayers old) (ite a target (defTargets old))
   (+ (defSchema old) (ite s 1 0))
   (+ (defRestriction old) (ite r 1 0))
   (+ (defAssociation old) (ite a 1 0))
   (+ (defDomain old) (ite effective 1 0)) (+ (defGeneration old) 1)) old))
(declare-const defOld DefState)
(declare-const defTarget Int)
(declare-const defS Bool)
(declare-const defR Bool)
(declare-const defA Bool)
(declare-const defEffective Bool)
(declare-const defVersions Bool)
(declare-const defBase Bool)
(declare-const defSG Bool)
(declare-const defRG Bool)
(declare-const defAG Bool)
(define-fun defNext () DefState
 (defStep defOld defTarget defS defR defA defEffective defVersions defBase defSG defRG defAG))
(define-fun defAdmission () Bool
 (defEligible defOld defS defR defA defEffective defVersions defBase defSG defRG defAG))

(echo "BASE-DEF-AUTHORED-FRAME")
(push)
(assert (defValid defOld))
(check-sat)
(assert (not (= (defLayers defNext) (defLayers defOld))))
(check-sat)
(pop)

(echo "BASE-DEF-VERSION-RANGE")
(push)
(assert defAdmission)
(check-sat)
(assert (not (defValid defNext)))
(check-sat)
(pop)

(echo "BASE-DEF-FACET-AUTHORITY")
(push)
(assert (and defAdmission (defChanged defS defR defA)))
(check-sat)
(assert (or (not defBase) (and defS (not defSG))
            (and defR (not defRG)) (and defA (not defAG))))
(check-sat)
(pop)

(echo "BASE-DEF-NOOP-EXHAUSTED")
(push)
(assert (= defOld (defState (defLayers defOld) (defTargets defOld)
 9007199254740991 9007199254740991 9007199254740991 9007199254740991 9007199254740991)))
(assert (and defBase (not defS) (not defR) (not defA) (not defEffective)
             (not defVersions) (not defSG) (not defRG) (not defAG)))
(check-sat)
(assert (or (not defAdmission) (not (= defNext defOld))))
(check-sat)
(pop)

(define-fun defABAFirst () DefState
 (defStep defOld 1 false false true false true true false false true))
(define-fun defABASecond () DefState
 (defStep defABAFirst 0 false false true false true true false false true))
(define-fun defABABasis () Bool
 (and (defValid defOld) (= (defTargets defOld) 0)
      (< (defAssociation defOld) 9007199254740990)
      (< (defGeneration defOld) 9007199254740990)))
(echo "BASE-DEF-ASSOCIATION-ABA")
(push)
(assert defABABasis)
(check-sat)
(assert (or (not (= (defTargets defOld) (defTargets defABASecond)))
            (= (defAssociation defOld) (defAssociation defABASecond))))
(check-sat)
(pop)

(declare-const defLost Bool)
(declare-const defBound Bool)
(declare-const defReady Bool)
(declare-const defTargetAbsent Bool)
(declare-const defPacket Bool)
(define-fun defObserveLoss ((lost Bool) (bound Bool) (ready Bool) (absent Bool)) Bool
 (or lost (and bound ready absent)))
(echo "BASE-DEF-TARGET-ABSENCE")
(push)
(assert (and (not defLost) defBound defReady defTargetAbsent (not defPacket)))
(check-sat)
(assert (not (defObserveLoss defLost defBound defReady defTargetAbsent)))
(check-sat)
(pop)

(echo "BASE-DEF-TARGET-ABSORPTION")
(push)
(assert (and defLost (not defTargetAbsent)))
(check-sat)
(assert (not (defObserveLoss defLost defBound defReady defTargetAbsent)))
(check-sat)
(pop)

(echo "BASE-DEF-VALUE-ONLY-CONTROL")
(push)
(assert (and defABABasis (= (defTargets defOld) (defTargets defABASecond))
             (not (= (defAssociation defOld) (defAssociation defABASecond)))))
(check-sat)
(pop)

(echo "BASE-DEF-PACKET-ONLY-CONTROL")
(push)
(assert (and (not defLost) defBound defReady defTargetAbsent (not defPacket)))
(assert (not (or defLost (and defBound defReady defTargetAbsent defPacket))))
(assert (defObserveLoss defLost defBound defReady defTargetAbsent))
(check-sat)
(pop)

; Bounded owner-issued layer incarnation high-water; accepted initial identities
; are at most the high-water. Removal retains it; restart/host truth is not modeled.
(declare-const layerHigh Int)
(declare-const layerCreated Int)
(declare-const layerRemoved Int)
(declare-const layerCap Int)
(declare-const layerOffset Int)
(declare-const layerHistorical Int)
(declare-const layerGeneration Int)
(declare-const layerDomain Int)
(declare-const layerTargetsChanged Bool)
(declare-const layerValuesChanged Bool)
(define-fun layerRange () Bool
 (and (<= 0 layerHigh) (<= layerHigh layerCap) (<= 0 layerCreated)
      (<= 0 layerRemoved) (<= 0 layerCap)))
(define-fun layerIssueAllowed () Bool
 (and layerRange (<= layerCreated (- layerCap layerHigh))))
(define-fun layerNextHigh () Int (+ layerHigh layerCreated))
(define-fun layerChanged () Bool
 (or (> layerCreated 0) (> layerRemoved 0) layerTargetsChanged))
(define-fun layerNextGeneration () Int
 (+ layerGeneration (ite layerChanged 1 0)))
(define-fun layerNextDomain () Int
 (+ layerDomain (ite layerValuesChanged 1 0)))

(echo "BASE-LAYER-ISSUER-RANGE")
(push)
(assert layerIssueAllowed)
(check-sat)
(assert (or (< layerNextHigh 0) (> layerNextHigh layerCap)))
(check-sat)
(pop)

(echo "BASE-LAYER-FRESH-INCARNATION")
(push)
(assert (and layerIssueAllowed (<= 1 layerOffset) (<= layerOffset layerCreated)
             (<= 1 layerHistorical) (<= layerHistorical layerHigh)))
(check-sat)
(assert (= (+ layerHigh layerOffset) layerHistorical))
(check-sat)
(pop)

(echo "BASE-LAYER-REMOVE-NONREFUND")
(push)
(assert (and layerIssueAllowed (= layerCreated 0) (> layerRemoved 0)))
(check-sat)
(assert (not (= layerNextHigh layerHigh)))
(check-sat)
(pop)

(echo "BASE-LAYER-EXHAUSTION")
(push)
(assert (and layerRange (= layerHigh layerCap) (> layerCreated 0)))
(check-sat)
(assert layerIssueAllowed)
(check-sat)
(pop)

(echo "BASE-LAYER-NOOP-FRAME")
(push)
(assert (and layerIssueAllowed (= layerCreated 0) (= layerRemoved 0)
             (not layerTargetsChanged) (= layerHigh layerCap)
             (= layerGeneration layerCap)))
(check-sat)
(assert (or (not (= layerNextHigh layerHigh))
            (not (= layerNextGeneration layerGeneration))))
(check-sat)
(pop)

(echo "BASE-LAYER-DISJOINT-FRAME")
(push)
(assert (and layerIssueAllowed (> layerCreated 0) (not layerTargetsChanged)
             (not layerValuesChanged) (> layerDomain 0)))
(check-sat)
(assert (not (= layerNextDomain layerDomain)))
(check-sat)
(pop)

(echo "BASE-LAYER-CALLER-INCARNATION-CONTROL")
(push)
(assert (and layerIssueAllowed (> layerHigh 0) (= layerCreated 1)
             (= layerHistorical layerHigh) (<= layerHistorical layerCap)))
; A range-only caller identity rule accepts this already-issued incarnation.
(check-sat)
(pop)

(echo "BASE-LAYER-REFUND-CONTROL")
(push)
(assert (and layerRange (> layerHigh 0) (= layerCreated 0) (= layerRemoved 1)))
(assert (= (+ (- layerHigh layerRemoved) 1) layerHigh))
; Refunding one removal lets the next single allocation reuse the old high-water.
(check-sat)
(pop)
