; D03 local conditional laws. Opaque intent equality is a refinement premise.
(set-logic ALL)
(set-option :timeout 10000)
(declare-const currentEpoch Int)
(declare-const currentGeneration Int)
(declare-const requestEpoch Int)
(declare-const requestGeneration Int)
(declare-const fresh Bool)
(declare-const granted Bool)
(declare-const expectedIntent (Array Int Int))
(declare-const requestIntent (Array Int Int))
(declare-const executions Int)
(declare-const publications Int)
(declare-const retained Bool)
(declare-const obligation Int)
(define-fun sameTicket () Bool (and (= currentEpoch requestEpoch) (= currentGeneration requestGeneration)))
(define-fun admit () Bool (and sameTicket fresh granted))
(define-fun executionsAfter () Int (+ executions (ite admit 1 0)))
(define-fun duplicate () Bool (and sameTicket (not fresh) (= expectedIntent requestIntent)))
(define-fun mismatch () Bool (and sameTicket (not fresh) (distinct expectedIntent requestIntent)))
(define-fun disclose () Bool (and duplicate retained granted))
(echo "RPL-DUPLICATE-FRAME")
(push)
(assert duplicate)
(check-sat)
(assert (not (and (not admit) (= executionsAfter executions))))
(check-sat)
(pop)
(echo "RPL-INTENT-BINDING")
(push)
(assert mismatch)
(check-sat)
(assert (not (and (not admit) (not duplicate) (= executionsAfter executions))))
(check-sat)
(pop)
(echo "RPL-RETIRED-FENCE")
(push)
(assert (not sameTicket))
(check-sat)
(assert (not (and (not admit) (= executionsAfter executions))))
(check-sat)
(pop)
(echo "RPL-RELEASE-GATE")
(push)
(assert (not granted))
(check-sat)
(assert disclose)
(check-sat)
(pop)
(echo "RPL-AT-MOST-ONCE-STEP")
(push)
; Freshness is consumed atomically by first admission; never reconstructed from cache absence.
(assert (and (<= 0 executions 1) (= fresh (= executions 0))))
(check-sat)
(assert (not (<= 0 executionsAfter 1)))
(check-sat)
(pop)
(echo "RPL-FORGOTTEN-APPLIED-CONTROL")
(push)
(assert (and (not retained) (= publications 1)))
(check-sat)
(pop)
(echo "RPL-CACHE-MISS-FRESH-CONTROL")
(push)
(assert (and sameTicket granted (not fresh) (not retained) (= executions 1)))
; Faulty cache-miss admission would produce two executions.
(assert (> (+ executions (ite (not retained) 1 0)) 1))
(check-sat)
(pop)
(echo "RPL-RETIREMENT-DISCHARGE-CONTROL")
(push)
(assert (and (not fresh) (not retained) (> obligation 0)))
(check-sat)
(pop)
(echo "RPL-INTENT-MISMATCH-CONTROL")
(push)
(assert mismatch)
; Checking ticket alone would wrongly treat changed intent as a duplicate.
(assert (not duplicate))
(check-sat)
(pop)
