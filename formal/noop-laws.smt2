; D01 conditional semantic/bookkeeping frame laws, not concrete classifiers.
(set-logic ALL)
(set-option :timeout 10000)
(declare-const current (Array Int Int))
(declare-const candidate (Array Int Int))
(declare-const book (Array Int Int))
(declare-const proposedBook (Array Int Int))
(declare-const valid Bool)
(declare-const stopped Bool)
(declare-const effect Bool)
(define-fun eligible () Bool (and valid (not stopped)))
(define-fun identity () Bool (and (= current candidate) (not effect)))
(define-fun unchanged () Bool (and eligible identity))
(define-fun publication () Bool (and eligible (distinct current candidate)))
(define-fun after () (Array Int Int) (ite publication candidate current))
(define-fun bookAfter () (Array Int Int) (ite publication proposedBook book))
(define-fun effectRequested () Bool (and eligible effect))
(echo "NOP-UNCHANGED-FRAME")
(push)
(assert (and valid (not stopped) identity))
(check-sat)
(assert (not (and unchanged (= after current) (= bookAfter book)
  (not publication) (not effectRequested))))
(check-sat)
(pop)
(echo "NOP-VALIDATION-GATE")
(push)
(assert (or (not valid) stopped))
(check-sat)
(assert (not (and (not unchanged) (not publication) (not effectRequested)
  (= after current) (= bookAfter book))))
(check-sat)
(pop)
(echo "NOP-MEANINGFUL-PARTICIPANTS")
(push)
; Coordinate zero stands for source; other coordinates are semantic companions.
(assert (and valid (not stopped) (= (select current 0) (select candidate 0))
  (distinct current candidate)))
(check-sat)
(assert (not (and (not unchanged) publication (= after candidate))))
(check-sat)
(pop)
(echo "NOP-EFFECT-INTENT")
(push)
(assert (and valid (not stopped) effect (= current candidate)))
(check-sat)
(assert (not (and (not unchanged) effectRequested (not publication)
  (= after current) (= bookAfter book))))
(check-sat)
(pop)
(echo "NOP-BYPASS-CONTROL")
(push)
(assert (and (not valid) (not stopped) identity))
; A faulty identity-only classifier says unchanged success despite invalidity.
(assert (and identity (not unchanged)))
(check-sat)
(pop)
(echo "NOP-SOURCE-ONLY-CONTROL")
(push)
(assert (and eligible (not effect) (= (select current 0) (select candidate 0))
  (distinct current candidate) (not unchanged)))
(check-sat)
(pop)
(echo "NOP-EFFECT-DROP-CONTROL")
(push)
(assert (and eligible effect (= current candidate) (not unchanged)))
(check-sat)
(pop)
(echo "NOP-BOOKKEEPING-CONTROL")
(push)
(assert (and unchanged (distinct proposedBook book)))
; Installing proposed bookkeeping would violate the unchanged frame.
(check-sat)
(pop)
