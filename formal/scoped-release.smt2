; Conditional bounded-release/projection laws, not policy truth or physical transfer.
(set-logic ALL)
(set-option :timeout 10000)
(declare-const capturedGrant Bool)
(declare-const currentGrant Bool)
(declare-const scopeMatches Bool)
(declare-const retained Bool)
(declare-const valid Bool)
(declare-const continuous Bool)
(declare-const epoch Int)
(declare-const capturedEpoch Int)
(define-fun allowed () Bool (and capturedGrant currentGrant scopeMatches retained valid continuous (= epoch capturedEpoch)))
(echo "REL-CURRENT-GATE")
(push)
(assert allowed)
(check-sat)
(assert (not (and currentGrant scopeMatches retained valid continuous (= epoch capturedEpoch))))
(check-sat)
(pop)
(declare-const ceiling (_ BitVec 6))
(declare-const approved (_ BitVec 6))
(define-fun effective () (_ BitVec 6) (bvand ceiling approved))
(echo "REL-CAPTURE-MEET")
(push)
(check-sat)
(assert (or (not (= (bvand effective ceiling) effective))
  (not (= (bvand effective approved) effective))))
(check-sat)
(pop)
(echo "REL-INVALIDATED-CONTEXT")
(push)
(assert (not (= epoch capturedEpoch)))
(check-sat)
(assert allowed)
(check-sat)
(pop)
(declare-const queued Int)
(declare-const baseline Int)
(define-fun incremental () Bool (and currentGrant (= baseline epoch) (= queued epoch)))
(echo "REL-STREAM-CONTINUITY")
(push)
(assert incremental)
(check-sat)
(assert (or (not currentGrant) (not (= baseline epoch)) (not (= queued epoch))))
(check-sat)
(pop)
(declare-const visible Int)
(declare-const hiddenA Int)
(declare-const hiddenB Int)
(define-fun projectedCount ((hidden Int)) Int visible)
(echo "REL-VISIBLE-COUNT")
(push)
(assert (and (>= visible 0) (>= hiddenA 0) (>= hiddenB 0)))
(check-sat)
(assert (not (= (projectedCount hiddenA) (projectedCount hiddenB))))
(check-sat)
(pop)
(echo "REL-POSSESSION-GRANT-CONTROL")
(push)
(assert (and capturedGrant (not currentGrant)))
(check-sat)
(pop)
(echo "REL-ENQUEUE-GRANT-CONTROL")
(push)
(assert (and capturedGrant currentGrant (not (= capturedEpoch epoch))))
(check-sat)
(pop)
(echo "REL-GLOBAL-COUNT-CONTROL")
(push)
(assert (and (>= visible 0) (>= hiddenA 0) (>= hiddenB 0)
  (not (= (+ visible hiddenA) (+ visible hiddenB)))))
(check-sat)
(pop)
(echo "REL-REGRANT-RESUME-CONTROL")
(push)
(assert (and currentGrant (= queued 0) (= epoch 2) (= baseline 0)))
(check-sat)
(pop)

; Native annotation receipt disclosure: five admissible identity/version capabilities.
(declare-const narCI Bool)
(declare-const narCB Bool)
(declare-const narCT Bool)
(declare-const narNI Bool)
(declare-const narNB Bool)
(declare-const narNT Bool)
(define-fun narCap ((i Bool) (b Bool) (t Bool)) Bool (or i (and (not b) (not t))))
(echo "REL-ANNOTATION-CAPABILITY-CLOSURE")
(push)
(assert (and (narCap narCI narCB narCT) (narCap narNI narNB narNT)))
(check-sat)
(assert (not (and (narCap false false false) (narCap true true true)
                 (narCap (and narCI narNI) (and narCB narNB) (and narCT narNT))
                 (narCap (or narCI narNI) (or narCB narNB) (or narCT narNT)))))
(check-sat)
(pop)
(echo "REL-ANNOTATION-INTERSECTION-BOUND")
(push)
(assert (and (narCap narCI narCB narCT) (narCap narNI narNB narNT)))
(check-sat)
(assert (or (and narCI narNI (or (not narCI) (not narNI)))
            (and narCI narNI narCB narNB (or (not narCB) (not narNB)))
            (and narCI narNI narCT narNT (or (not narCT) (not narNT)))))
(check-sat)
(pop)
(declare-const narInvocationMatches Bool)
(declare-const narIdentityMatches Bool)
(declare-const narContextMatches Bool)
(declare-const narCurrentRelease Bool)
(define-fun narEligible () Bool (and narCI narNI narInvocationMatches narIdentityMatches narContextMatches narCurrentRelease))
(echo "REL-ANNOTATION-DECISION-BINDING")
(push)
(assert (and narCI narNI))
(check-sat)
(assert (and narEligible (not (and narInvocationMatches narIdentityMatches narContextMatches narCurrentRelease))))
(check-sat)
(pop)
(declare-const narCapturedEpoch Int)
(declare-const narCurrentEpoch Int)
(define-fun narEligibleEpoch () Bool (and narEligible (= narCapturedEpoch narCurrentEpoch)))
(echo "REL-ANNOTATION-STALE-EPOCH")
(push)
(assert (and (>= narCapturedEpoch 0) (>= narCurrentEpoch 0) (not (= narCapturedEpoch narCurrentEpoch))))
(check-sat)
(assert narEligibleEpoch)
(check-sat)
(pop)
(echo "REL-ANNOTATION-CURRENT-ONLY-CONTROL")
(push)
(assert (and (narCap narCI narCB narCT) (narCap narNI narNB narNT) (not narCI) narNI))
(check-sat)
(pop)
(declare-const narCapturedVersion Int)
(declare-const narLaterVersion Int)
(echo "REL-ANNOTATION-ROW-LOOKUP-CONTROL")
(push)
(assert (and (> narCapturedVersion 0) (> narLaterVersion narCapturedVersion) (<= narLaterVersion 9007199254740991)))
(check-sat)
(pop)

; Owned history contexts: conditional metadata/frontier-basis laws, not code refinement.
(declare-const hcxOwned Bool)
(declare-const hcxLive Bool)
(declare-const hcxScope Bool)
(declare-const hcxGates Bool)
(declare-const hcxVisibleEqual Bool)
(declare-const hcxHiddenEqual Bool)
(declare-const hcxGroupEqual Bool)
(define-fun hcxRelease () Bool (and hcxOwned hcxLive hcxScope hcxGates hcxVisibleEqual hcxHiddenEqual hcxGroupEqual))
(echo "REL-HISTORY-PARTICIPANT-BASIS")
(push)
(assert (and hcxVisibleEqual (not hcxHiddenEqual)))
(check-sat)
(assert hcxRelease)
(check-sat)
(pop)
(declare-const hcxPublicationA Int)
(declare-const hcxPublicationB Int)
(echo "REL-HISTORY-UNRELATED-PUBLICATION")
(push)
(assert (and (>= hcxPublicationA 0) (> hcxPublicationB hcxPublicationA)
             hcxOwned hcxLive hcxScope hcxGates hcxVisibleEqual hcxHiddenEqual hcxGroupEqual))
(check-sat)
(assert (not hcxRelease))
(check-sat)
(pop)
(declare-const hcxObservedMismatch Bool)
(define-fun hcxNextLive () Bool (and hcxLive (not hcxObservedMismatch)))
(echo "REL-HISTORY-OBSERVED-INVALIDATION")
(push)
(assert hcxObservedMismatch)
(check-sat)
(assert hcxNextLive)
(check-sat)
(pop)
(declare-const hcxIssued Int)
(declare-const hcxMaximum Int)
(declare-const hcxContexts Int)
(declare-const hcxContextMaximum Int)
(define-fun hcxCanIssue () Bool (and (< hcxIssued hcxMaximum) (< hcxContexts hcxContextMaximum)))
(echo "REL-HISTORY-LIFETIME-ISSUANCE")
(push)
(assert (and (> hcxMaximum 0) (= hcxIssued hcxMaximum) (= hcxContexts 0) (> hcxContextMaximum 0)))
(check-sat)
(assert hcxCanIssue)
(check-sat)
(pop)
(echo "REL-HISTORY-VISIBLE-ONLY-CONTROL")
(push)
(assert (and hcxOwned hcxLive hcxScope hcxGates hcxVisibleEqual hcxGroupEqual (not hcxHiddenEqual)))
(check-sat)
(pop)
(echo "REL-HISTORY-RESET-ISSUANCE-CONTROL")
(push)
(assert (and (> hcxMaximum 0) (= hcxIssued hcxMaximum) (= hcxContexts 0) (> hcxContextMaximum 0)
             (< 0 hcxMaximum) (< hcxContexts hcxContextMaximum)))
(check-sat)
(pop)

; Native reversal receipts: 0 unknown, 1 applied, 2 confirmed not-published.
(declare-const rrStatus Int)
(declare-const rrRetained Bool)
(declare-const rrCapturedTarget Bool)
(declare-const rrCurrentTarget Bool)
(declare-const rrInvocationScope Bool)
(declare-const rrAuthorityScope Bool)
(declare-const rrOriginalTarget Bool)
(define-fun rrTargetRelease () Bool (and rrRetained (= rrStatus 1) rrCapturedTarget rrCurrentTarget rrInvocationScope rrAuthorityScope rrOriginalTarget))
(echo "REL-REVERSAL-TARGET-MEET")
(push)
(assert (and (>= rrStatus 0) (<= rrStatus 2)))
(check-sat)
(assert (and rrTargetRelease (or (not rrCapturedTarget) (not rrCurrentTarget))))
(check-sat)
(pop)
(echo "REL-REVERSAL-ORIGINAL-SCOPE")
(push)
(assert (and (= rrStatus 1) rrCapturedTarget rrCurrentTarget))
(check-sat)
(assert (and rrTargetRelease (not (and rrInvocationScope rrAuthorityScope rrOriginalTarget))))
(check-sat)
(pop)
(declare-const rrOriginalDirection Int)
(declare-const rrLaterDirection Int)
(define-fun rrReadDirection ((original Int) (later Int)) Int original)
(echo "REL-REVERSAL-HISTORICAL-DECISION")
(push)
(assert (and (or (= rrOriginalDirection 0) (= rrOriginalDirection 1))
             (or (= rrLaterDirection 0) (= rrLaterDirection 1)) (not (= rrOriginalDirection rrLaterDirection))))
(check-sat)
(assert (not (= (rrReadDirection rrOriginalDirection rrLaterDirection) rrOriginalDirection)))
(check-sat)
(pop)
(define-fun rrKnownNotPublished () Bool (and rrRetained (= rrStatus 2)))
(echo "REL-REVERSAL-KNOWN-NONPUBLICATION")
(push)
(assert (and rrRetained (or (= rrStatus 0) (= rrStatus 2))))
(check-sat)
(assert (or (and (= rrStatus 0) rrKnownNotPublished) (and (= rrStatus 2) rrTargetRelease)))
(check-sat)
(pop)
(echo "REL-REVERSAL-CURRENT-ONLY-CONTROL")
(push)
(assert (and rrRetained (= rrStatus 1) (not rrCapturedTarget) rrCurrentTarget rrInvocationScope rrAuthorityScope rrOriginalTarget))
(check-sat)
(pop)
(echo "REL-REVERSAL-UNKNOWN-REFUSAL-CONTROL")
(push)
(assert (and (= rrStatus 0) (not rrRetained)))
(check-sat)
(pop)

; Actual invocation observation: local phase projection and finite logical wait rank.
(declare-const nioPhase Int)
(declare-const nioRichA Int)
(declare-const nioRichB Int)
(define-fun nioControlReference ((phase Int) (rich Int)) Int phase)
(echo "REL-NATIVE-CONTROL-ISOLATION")
(push)
(assert (and (or (= nioPhase 0) (= nioPhase 1)) (not (= nioRichA nioRichB))))
(check-sat)
(assert (not (= (nioControlReference nioPhase nioRichA) (nioControlReference nioPhase nioRichB))))
(check-sat)
(pop)
(declare-const nioOrdinaryIssued Int)
(declare-const nioOrdinaryMaximum Int)
(declare-const nioControlIssued Int)
(echo "REL-NATIVE-CONTROL-RESERVE")
(push)
(assert (and (>= nioOrdinaryMaximum 0) (= nioOrdinaryIssued nioOrdinaryMaximum) (>= nioControlIssued 0) (< nioControlIssued 2)))
(check-sat)
(assert (not (< nioControlIssued 2)))
(check-sat)
(pop)
(declare-const nioRemaining Int)
(declare-const nioNextRemaining Int)
(echo "REL-NATIVE-WAIT-RANK")
(push)
(assert (and (> nioRemaining 0) (= nioNextRemaining (- nioRemaining 1))))
(check-sat)
(assert (not (and (>= nioNextRemaining 0) (< nioNextRemaining nioRemaining))))
(check-sat)
(pop)
(declare-const nioProducerStarts Int)
(declare-const nioNextProducerStarts Int)
(declare-const nioProducerPublications Int)
(declare-const nioNextProducerPublications Int)
(echo "REL-NATIVE-WAIT-NONEXECUTION")
(push)
(assert (and (>= nioProducerStarts 0) (>= nioProducerPublications 0)
             (= nioNextProducerStarts nioProducerStarts) (= nioNextProducerPublications nioProducerPublications)))
(check-sat)
(assert (or (not (= nioNextProducerStarts nioProducerStarts)) (not (= nioNextProducerPublications nioProducerPublications))))
(check-sat)
(pop)
(echo "REL-NATIVE-RICH-PROGRESS-CONTROL")
(push)
(assert (and (= nioPhase 1) (not (= nioRichA nioRichB))
             (not (= (+ nioPhase nioRichA) (+ nioPhase nioRichB)))))
(check-sat)
(pop)
(echo "REL-NATIVE-POLL-TIME-CONTROL")
(push)
(assert (and (> nioRemaining 0) (= nioNextRemaining nioRemaining)))
(check-sat)
(pop)

; Native settings read lifecycle: admitted bound observations only.
; Host fact truth and the JavaScript-to-model correspondence are separate premises.
(declare-const settingsHeldInvalid Bool)
(declare-const settingsBoundObservation Bool)
(declare-const settingsObservedGap Bool)
(declare-const settingsProjectionChanged Bool)
(declare-const settingsCurrentEligible Bool)
(define-fun settingsNextInvalid () Bool
  (or settingsHeldInvalid
      (and settingsBoundObservation (or settingsObservedGap settingsProjectionChanged))))
(define-fun settingsRelease () Bool
  (and settingsCurrentEligible (not settingsNextInvalid)))
(echo "REL-SETTING-OBSERVED-GAP-ABSORPTION")
(push)
(assert (or settingsHeldInvalid
            (and settingsBoundObservation (or settingsObservedGap settingsProjectionChanged))))
(assert settingsCurrentEligible)
(check-sat)
(assert settingsRelease)
(check-sat)
(pop)
(echo "REL-SETTING-UNOBSERVED-FRAME")
(push)
(assert (not (and settingsBoundObservation
                  (or settingsObservedGap settingsProjectionChanged))))
(check-sat)
(assert (distinct settingsNextInvalid settingsHeldInvalid))
(check-sat)
(pop)
(echo "REL-SETTING-REGRANT-CONTROL")
(push)
(assert settingsHeldInvalid)
(assert settingsCurrentEligible)
; The weakened release forgets the retained invalidation bit.
(assert (and settingsCurrentEligible (not settingsRelease)))
(check-sat)
(pop)
(echo "REL-SETTING-FOREIGN-INVALIDATION-CONTROL")
(push)
(assert (not settingsBoundObservation))
(assert (not settingsHeldInvalid))
(assert settingsObservedGap)
; The weakened update invalidates on a claim without a bound observation.
(assert (and (or settingsHeldInvalid settingsObservedGap) (not settingsNextInvalid)))
(check-sat)
(pop)
