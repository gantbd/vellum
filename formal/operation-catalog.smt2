; Conditional family routing, not an execution/provider/Rust refinement theorem.
(set-logic ALL)
(set-option :timeout 10000)
(declare-const supported Bool)
(declare-const grant Bool)
(declare-const current Bool)
(declare-const capacity Bool)
(declare-const releaseAllowed Bool)
(define-fun queryRoute () Int (ite (and supported grant current capacity releaseAllowed) 1 0))
(echo "CAT-QUERY-ROUTE")
(push)
(check-sat)
(assert (not (or (= queryRoute 0) (= queryRoute 1))))
(check-sat)
(pop)
(define-fun ordinaryRoute () Int (ite (and supported grant current capacity) 2 0))
(echo "CAT-UNKNOWN-REFUSAL")
(push)
(assert (not supported))
(check-sat)
(assert (not (= ordinaryRoute 0)))
(check-sat)
(pop)
(declare-const typed Int)
(declare-const dynamic Int)
(declare-fun route (Int Bool Bool) Int)
(echo "CAT-CANONICAL-CONGRUENCE")
(push)
(assert (= typed dynamic))
(check-sat)
(assert (not (= (route typed grant current) (route dynamic grant current))))
(check-sat)
(pop)
(declare-const validEvidence Bool)
(declare-const protectedCapacity Bool)
(define-fun evidenceRoute ((observerGrant Bool)) Int (ite validEvidence (ite protectedCapacity 4 5) 0))
(echo "CAT-EVIDENCE-OBSERVER-SEPARATION")
(push)
(assert (and validEvidence protectedCapacity))
(check-sat)
(assert (not (= (evidenceRoute false) (evidenceRoute true))))
(check-sat)
(pop)
(echo "CAT-PROTECTED-RETENTION")
(push)
(assert (and validEvidence (not protectedCapacity)))
(check-sat)
(assert (not (= (evidenceRoute grant) 5)))
(check-sat)
(pop)
(define-fun derivedAccepted () Bool (and validEvidence supported grant current capacity))
(echo "CAT-DERIVED-CURRENT")
(push)
(assert derivedAccepted)
(check-sat)
(assert (or (not current) (not grant)))
(check-sat)
(pop)
(define-fun controlRoute ((ordinaryCapacity Bool)) Int
  (ite (and supported grant current) (ite protectedCapacity 6 5) 0))
(echo "CAT-PROTECTED-CONTROL-LANE")
(push)
(assert (and supported grant current protectedCapacity))
(check-sat)
(assert (or (not (= (controlRoute false) 6)) (not (= (controlRoute false) (controlRoute true)))))
(check-sat)
(pop)
(echo "CAT-QUERY-MUTATION-CONTROL")
(push)
(declare-const badRoute Int)
(assert (= badRoute 2))
(check-sat)
(pop)
(echo "CAT-DISCOVERY-GRANT-CONTROL")
(push)
(declare-const discovered Bool)
(assert (and discovered (not grant) supported))
(check-sat)
(pop)
(echo "CAT-HISTORICAL-LIVE-GATE-CONTROL")
(push)
(assert (and validEvidence protectedCapacity (not current) (not grant)))
(check-sat)
(pop)
