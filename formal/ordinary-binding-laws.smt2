; Conditional ordinary source/annotation destination policy, not a host alias oracle.
(set-logic ALL)
(set-option :timeout 10000)
(declare-datatypes () ((Relation known-equivalent known-distinct unknown incomparable)))
(declare-const sourcePresent Bool)
(declare-const annotationPresent Bool)
(declare-const relation Relation)
(declare-const identityEvidenceCurrent Bool)
(declare-const completeCoverage Bool)
(declare-const currentPair Bool)
(declare-const ownerAllowed Bool)
(declare-const sourceIdentity Int)
(declare-const annotationIdentity Int)
(declare-const overwriteAllowed Bool)
(define-fun both () Bool (and sourcePresent annotationPresent))
(define-fun compatible () Bool
 (or (not both) (and identityEvidenceCurrent (= relation known-distinct))))
(define-fun accept () Bool (and ownerAllowed completeCoverage currentPair compatible))
; Integers stand for the host's actual equivalence classes, not path/key strings.
(define-fun soundDistinction () Bool
 (=> (= relation known-distinct) (not (= sourceIdentity annotationIdentity))))
(define-fun invariant () Bool (or (not both) (not (= sourceIdentity annotationIdentity))))

(echo "OD-KNOWN-DISTINCTION")
(push)
(assert (and both accept soundDistinction))
(check-sat)
(assert (not invariant))
(check-sat)
(pop)

(echo "OD-KNOWN-EQUIVALENCE")
(push)
(assert (and both ownerAllowed completeCoverage currentPair identityEvidenceCurrent overwriteAllowed (= relation known-equivalent)))
(check-sat)
(assert accept)
(check-sat)
(pop)

(echo "OD-UNKNOWN")
(push)
(assert (and both ownerAllowed completeCoverage currentPair identityEvidenceCurrent (= relation unknown)))
(check-sat)
(assert accept)
(check-sat)
(pop)

(echo "OD-INCOMPARABLE")
(push)
(assert (and both ownerAllowed completeCoverage currentPair identityEvidenceCurrent (= relation incomparable)))
(check-sat)
(assert accept)
(check-sat)
(pop)

(echo "OD-CURRENT-PAIR")
(push)
(assert (and ownerAllowed completeCoverage compatible (not currentPair)))
(check-sat)
(assert accept)
(check-sat)
(pop)

(echo "OD-STALE-DISTINCTION")
(push)
(assert (and both ownerAllowed completeCoverage currentPair (not identityEvidenceCurrent) (= relation known-distinct)))
(check-sat)
(assert accept)
(check-sat)
(pop)

(echo "OD-UNBOUND-ABSENCE")
(push)
(assert (and ownerAllowed completeCoverage currentPair (not sourcePresent) (= relation unknown) (not identityEvidenceCurrent)))
(check-sat)
(assert (not accept))
(check-sat)
(pop)

; Logical validation epochs illustrate a serialized pair check. No concrete
; public counter/handle, storage layout or native binding representation is chosen.
(declare-const capturedEpoch Int)
(declare-const afterFirstEpoch Int)
(declare-const secondAccepted Bool)
(echo "OD-SERIALIZED-PAIR")
(push)
(assert (= afterFirstEpoch (+ capturedEpoch 1)))
(assert (= secondAccepted (and ownerAllowed completeCoverage compatible (= capturedEpoch afterFirstEpoch))))
(assert (and ownerAllowed completeCoverage compatible))
(check-sat)
(assert secondAccepted)
(check-sat)
(pop)

(declare-const candidateIdentity Int)
(define-fun snapshotSourceAllowed () Bool (and ownerAllowed completeCoverage currentPair (not annotationPresent)))
(define-fun snapshotAnnotationAllowed () Bool (and ownerAllowed completeCoverage currentPair (not sourcePresent)))
(echo "OD-WRITE-SKEW-CONTROL")
(push)
; Independently checking each proposal against the old absent opposite allows
; both bindings to select the same resource when the final pair check is omitted.
(assert (and snapshotSourceAllowed snapshotAnnotationAllowed))
(assert (= sourceIdentity candidateIdentity))
(assert (= annotationIdentity candidateIdentity))
(assert (= sourceIdentity annotationIdentity))
(check-sat)
(pop)

(declare-const sourceLocator String)
(declare-const annotationLocator String)
(echo "OD-LOCATOR-DIFFERENCE-CONTROL")
(push)
(assert (and both ownerAllowed completeCoverage currentPair))
(assert (not (= sourceLocator annotationLocator)))
(assert (= sourceIdentity annotationIdentity))
; A broken locator-only comparison would allow an actual alias collision.
(check-sat)
(pop)

(declare-const exportAllowed Bool)
(declare-const exportDestination Int)
(declare-const nextSourceIdentity Int)
(declare-const nextAnnotationIdentity Int)
(echo "OD-EXPORT-FRAME")
(push)
(assert (and both invariant exportAllowed (= exportDestination sourceIdentity)))
(assert (= nextSourceIdentity sourceIdentity))
(assert (= nextAnnotationIdentity annotationIdentity))
(check-sat)
(assert (= nextSourceIdentity nextAnnotationIdentity))
(check-sat)
(pop)
