; Conditional local lifecycle laws; trusted identity/disposition/witness premises.
(set-logic ALL)
(set-option :timeout 10000)
(declare-const oldInc Int)
(declare-const newInc Int)
(declare-const captured Int)
(declare-const live Bool)
(declare-const grant Bool)
(define-fun accepts () Bool (and live grant (= captured newInc)))
(echo "LIFE-FRESH-INCARNATION")
(push)
(assert (and (> newInc oldInc) (= captured oldInc)))
(check-sat)
(assert accepts)
(check-sat)
(pop)
(echo "LIFE-DISPOSED-MUTATION")
(push)
(assert (not live))
(check-sat)
(assert accepts)
(check-sat)
(pop)
(declare-const dirtySource Bool)
(declare-const dirtyAnnotation Bool)
(declare-const discardSource Bool)
(declare-const discardAnnotation Bool)
(declare-const held Int)
(declare-const retain Bool)
(define-fun disposable () Bool (and live grant (or (not dirtySource) discardSource)
  (or (not dirtyAnnotation) discardAnnotation) (or (= held 0) retain)))
(echo "LIFE-DISPOSAL-GUARD")
(push)
(assert (and (>= held 0) disposable))
(check-sat)
(assert (or (and dirtySource (not discardSource)) (and dirtyAnnotation (not discardAnnotation))
  (and (> held 0) (not retain))))
(check-sat)
(pop)
(declare-const witness Bool)
(declare-const amount Int)
(define-fun remaining () Int (ite witness (- held amount) held))
(echo "LIFE-DISCHARGE-WITNESS")
(push)
(assert (and (<= 0 amount held) (not witness)))
(check-sat)
(assert (not (= remaining held)))
(check-sat)
(pop)
(echo "LIFE-REUSED-INCARNATION-CONTROL")
(push)
(assert (and live grant (= newInc oldInc) (= captured oldInc) accepts))
(check-sat)
(pop)
(echo "LIFE-SOURCE-ONLY-DISPOSAL-CONTROL")
(push)
(assert (and live grant (not dirtySource) dirtyAnnotation (not discardAnnotation)))
(check-sat)
(pop)
(echo "LIFE-CANCEL-REFUND-CONTROL")
(push)
(assert (and (> held 0) (= amount held) (not witness) (= (- held amount) 0)))
(check-sat)
(pop)
