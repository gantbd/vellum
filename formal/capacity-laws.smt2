; D06 profile/activation guards, not physical-resource/default/scheduler proofs.
(set-logic ALL)
(set-option :timeout 10000)
(declare-const cap Int)
(declare-const floor Int)
(declare-const ordinary Int)
(declare-const held Int)
(declare-const demand Int)
(declare-const completionDemand Int)
(declare-const newCap Int)
(declare-const newFloor Int)
(declare-const granted Bool)
(define-fun partition () Bool (and (<= 0 floor cap) (<= 0 ordinary (- cap floor)) (<= 0 held floor)))
(define-fun compatible () Bool (and (<= 0 newFloor newCap)
  (<= ordinary (- newCap newFloor)) (<= held newFloor)))
(define-fun activate () Bool (and granted compatible))
(echo "CAP-PROTECTED-PARTITION")
(push)
(assert partition)
(check-sat)
(assert (> (+ ordinary held) cap))
(check-sat)
(pop)
(echo "CAP-ADMISSION-HEADROOM")
(push)
(assert (and partition (<= 0 demand (- cap floor ordinary)) (<= 0 completionDemand (- floor held))))
(check-sat)
(assert (not (and (<= (+ ordinary demand) (- cap floor))
  (<= (+ held completionDemand) floor)
  (<= (+ ordinary demand held completionDemand) cap))))
(check-sat)
(pop)
(echo "CAP-ACTIVATION-COMMITMENTS")
(push)
(assert (and partition activate))
(check-sat)
(assert (not (and (<= ordinary (- newCap newFloor)) (<= held newFloor)
  (<= (+ ordinary held) newCap))))
(check-sat)
(pop)
(declare-const used Int)
(declare-const softA Int)
(declare-const softB Int)
(define-fun hardAdmission ((soft Int)) Bool (and (<= 0 used cap) (<= 0 demand (- cap used))))
(echo "CAP-SOFT-NO-GRANT")
(push)
(assert (and (<= 0 softA cap) (<= 0 softB cap)))
(check-sat)
(assert (distinct (hardAdmission softA) (hardAdmission softB)))
(check-sat)
(pop)
(define-fun capAfter () Int (ite activate newCap cap))
(define-fun floorAfter () Int (ite activate newFloor floor))
(echo "CAP-REFUSAL-FRAME")
(push)
(assert (not activate))
(check-sat)
(assert (not (and (= capAfter cap) (= floorAfter floor))))
(check-sat)
(pop)
(declare-const spent Int)
(declare-const quota Int)
(declare-const newQuota Int)
(echo "CAP-CONSUMED-ACTIVATION")
(push)
(assert (and (<= 0 spent quota) (<= spent newQuota)))
(check-sat)
(assert (not (and (<= 0 (- newQuota spent)) (= (+ spent (- newQuota spent)) newQuota))))
(check-sat)
(pop)
(echo "CAP-BORROW-PROTECTED-CONTROL")
(push)
(assert (and (<= 0 floor cap) (> floor 0) (<= 0 ordinary cap) (> ordinary (- cap floor))))
(check-sat)
(pop)
(echo "CAP-SHRINK-HELD-CONTROL")
(push)
(assert (and partition (<= 0 newCap) (> (+ ordinary held) newCap)))
(check-sat)
(pop)
(echo "CAP-ESTIMATE-CEILING-CONTROL")
(push)
; A scheduler estimate fitting its budget does not establish another coordinate.
(assert (and (<= 0 softA cap) (<= 0 used softA) (> demand cap)))
(check-sat)
(pop)
(echo "CAP-RESET-QUOTA-CONTROL")
(push)
(assert (and (> spent 0) (<= spent newQuota) (> (+ spent newQuota) newQuota)))
(check-sat)
(pop)
