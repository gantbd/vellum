; Half-open capture intersections, not parser truth or engine-wide completeness.
(set-logic QF_LIA)
(set-option :timeout 10000)
(declare-const a Int)
(declare-const b Int)
(declare-const x Int)
(declare-const y Int)
(define-fun valid () Bool (and (<= 0 a) (<= a b) (<= 0 x) (< x y)))
(define-fun lo () Int (ite (< a x) x a))
(define-fun hi () Int (ite (< b y) b y))
(define-fun emit () Bool (and (< a b) (< x b) (< a y)))
(define-fun oldEmit () Bool (and (< x b) (< a y)))

(echo "AR-POSITIVE-INTERSECTION")
(push)
(assert valid)
(check-sat)
(assert (not (= emit (< lo hi))))
(check-sat)
(pop)

(echo "AR-CLIP-CONTAINMENT")
(push)
(assert (and valid emit))
(check-sat)
(assert (or (< lo a) (< lo x) (> hi b) (> hi y) (>= lo hi)))
(check-sat)
(pop)

(echo "AR-EMPTY-QUERY")
(push)
(assert (and valid (= a b)))
(check-sat)
(assert (or emit (< lo hi)))
(check-sat)
(pop)

(echo "AR-OLD-EMPTY-CONTROL")
(push)
(assert (and valid (= a 3) (= b 3) (= x 2) (= y 7)
             oldEmit (not emit) (= lo hi)))
(check-sat)
(pop)
