; D04 local profile lemmas. Not production anchor/identity/refinement proofs.
(set-logic ALL)
(set-option :timeout 10000)
(declare-const n Int)
(declare-const l Int)
(declare-const h Int)
(declare-const k Int)
(declare-const p Int)
(declare-const s Int)
(declare-const t Int)
(declare-const right Bool)
(define-fun valid () Bool (and (<= 0 l h n) (<= 0 k)))
(define-fun size () Int (+ n k (- l h)))
(define-fun point ((q Int) (r Bool)) Int
  (ite (< q l) q
    (ite (> q h) (+ q k (- l h))
      (ite (and (< l h) (= q l)) l
        (ite (and (< l h) (= q h)) (+ l k) (ite r (+ l k) l))))))
(define-fun rangeValid () Bool (and valid (<= 0 s) (< s t) (<= t n)))
(define-fun removed () Bool (and (< l h) (<= l s) (<= t h)))
(echo "MAP-POINT-BOUNDS")
(push)
(assert (and valid (<= 0 p n)))
(check-sat)
(assert (not (<= 0 (point p right) size)))
(check-sat)
(pop)
(echo "MAP-SURVIVING-RANGE-ORDER")
(push)
(assert (and rangeValid (not removed)))
(check-sat)
(assert (not (<= 0 (point s true) (point t false) size)))
(check-sat)
(pop)
(echo "MAP-EXCLUSIVE-BOUNDARIES")
(push)
(assert (and rangeValid (= l h) (or (= l s) (= l t))))
(check-sat)
(assert (not (and
  (=> (= l s) (and (= (point s true) (+ s k)) (= (point t false) (+ t k))))
  (=> (= l t) (and (= (point s true) s) (= (point t false) t))))))
(check-sat)
(pop)
(declare-const detached Bool)
(declare-const historyAvailable Bool)
(declare-const explicitlyReattached Bool)
(define-fun detachedAfter () Bool (and (not explicitlyReattached) (or detached removed)))
(echo "MAP-NO-AUTOMATIC-RESURRECTION")
(push)
(assert (and detached (not explicitlyReattached)))
(check-sat)
(assert (not detachedAfter))
(check-sat)
(pop)
(declare-const expectedRevision Int)
(declare-const currentRevision Int)
(declare-const granted Bool)
(define-fun eligible () Bool (and granted (= expectedRevision currentRevision)))
(echo "MAP-EXACT-PROPOSAL-GATE")
(push)
(assert (distinct expectedRevision currentRevision))
(check-sat)
(assert eligible)
(check-sat)
(pop)
(echo "MAP-COLLAPSED-OPPOSED-CONTROL")
(push)
(assert (and valid (= l h p) (> k 0)))
(assert (> (point p true) (point p false)))
(check-sat)
(pop)
(echo "MAP-CLAMP-SURVIVAL-CONTROL")
(push)
(assert (and rangeValid removed (<= 0 (point s true) size)))
; Valid geometry does not establish that any original target content survives.
(check-sat)
(pop)
(echo "MAP-MISSING-HISTORY-CONTROL")
(push)
(assert (and (not historyAvailable) valid (<= 0 p n) (<= 0 (point p right) size)))
; A numeric mapping can exist despite absent contextual mapping evidence.
(check-sat)
(pop)
(echo "MAP-PREVIEW-AUTHORITY-CONTROL")
(push)
(assert (and valid (<= 0 p n) (not granted) (= expectedRevision currentRevision)))
(assert (and (<= 0 (point p right) size) (not eligible)))
(check-sat)
(pop)
