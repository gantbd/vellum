@prefix v: <urn:vellum:model:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Closed validation scope: exactly the supplied graph and explicit catalog.
# RDF itself remains open-world; these shapes do not prove system completeness.
v:ElementShape a sh:NodeShape ;
  sh:targetClass v:Element ;
  sh:nodeKind sh:IRI ;
  sh:property [ sh:path v:identifier ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:string ; sh:pattern "^[A-Z]+-[0-9]{2}$" ] ;
  sh:property [ sh:path v:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:status ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in (v:Agreed v:Optional v:Proposed v:Deferred v:Mixed v:Modeled v:Unspecified) ] ;
  sh:property [ sh:path v:mentions ; sh:class v:Element ] ;
  sh:sparql [ sh:message "Model identifier must be unique." ;
    sh:select """
      PREFIX v: <urn:vellum:model:>
      SELECT $this WHERE {
        $this v:identifier ?id . ?other v:identifier ?id .
        FILTER ($this != ?other)
      }
    """ ] .

v:ComponentShape a sh:NodeShape ;
  sh:targetClass v:Component ;
  sh:property [ sh:path v:dependsOn ; sh:class v:Component ] ;
  sh:sparql [ sh:message "Architectural dependency cycle." ;
    sh:select """
      PREFIX v: <urn:vellum:model:>
      SELECT $this WHERE { $this v:dependsOn+ $this . }
    """ ] .

v:PrimitiveIsolationShape a sh:NodeShape ;
  sh:targetNode v:CMP-04 ;
  sh:property [ sh:path v:dependsOn ; sh:maxCount 0 ] .

v:InterfaceShape a sh:NodeShape ;
  sh:targetClass v:Interface ;
  sh:property [ sh:path v:source ; sh:minCount 1 ; sh:class v:Element ] ;
  sh:property [ sh:path v:target ; sh:minCount 1 ; sh:class v:Element ] ;
  sh:property [ sh:path v:carries ; sh:minCount 1 ; sh:class v:DataAsset ] ;
  sh:property [ sh:path v:crosses ; sh:minCount 1 ; sh:class v:TrustBoundary ] ;
  sh:property [ sh:path v:instrumentedBy ; sh:minCount 1 ; sh:class v:Instrumentation ] ;
  sh:property [ sh:path v:tracesTo ; sh:minCount 1 ; sh:class v:RequirementSection ] .

# Partial proof-slice coverage is not a verified flag on the whole invariant.
v:ProofSliceShape a sh:NodeShape ;
  sh:targetClass v:ProofSlice ;
  sh:property [ sh:path v:scope ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:partiallyAddresses ; sh:minCount 1 ; sh:class v:Invariant ] ;
  sh:property [ sh:path v:atInterface ; sh:minCount 1 ; sh:class v:Interface ] ;
  sh:property [ sh:path v:observedAt ; sh:minCount 1 ; sh:class v:Instrumentation ] ;
  sh:property [ sh:path v:assumes ; sh:minCount 1 ; sh:class v:Assumption ] ;
  sh:property [ sh:path v:tracesTo ; sh:minCount 1 ; sh:class v:RequirementSection ] ;
  sh:property [ sh:path v:hasCheck ; sh:minCount 1 ; sh:class v:ProofCheck ] .
v:ProofCheckShape a sh:NodeShape ;
  sh:targetClass v:ProofCheck ;
  sh:property [ sh:path v:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:expected ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("success" "counterexample" "witness") ] ;
  sh:property [ sh:path v:bound ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
  sh:property [ sh:path v:boundRole ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ("TransitionHorizon" "InitialBacklogCardinality" "UnusedHarnessParameter") ] ;
  sh:property [ sh:path v:specification ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:mode ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ("FinitePrefix" "FiniteStateBacklog" "StaticEnumeration") ] .

v:StaticEnumerationShape a sh:NodeShape ;
  sh:targetNode v:editor-sequence-algebra, v:editor-unmapped-anchor-control,
    v:editor-batch-composition, v:editor-unshifted-batch-control ;
  sh:property [ sh:path v:mode ; sh:hasValue "StaticEnumeration" ] ;
  sh:property [ sh:path v:boundRole ; sh:hasValue "UnusedHarnessParameter" ] ;
  sh:property [ sh:path v:sourceLengthLimit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
  sh:property [ sh:path v:insertionLengthLimit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
  sh:property [ sh:path v:alphabetSize ; sh:hasValue 2 ] .
v:BatchEnumerationShape a sh:NodeShape ;
  sh:targetNode v:editor-batch-composition, v:editor-unshifted-batch-control ;
  sh:property [ sh:path v:batchInsertionLengthLimit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] .

# Intent coverage, not installed telemetry or proof that a supplier is truthful.
v:ObservedCatalogShape a sh:NodeShape ;
  sh:targetClass v:Pathway, v:IdentityDimension, v:NetworkPath, v:DataFlow,
    v:DataAsset, v:Interface, v:Invariant, v:ProgressObligation, v:Assumption ;
  sh:property [ sh:path v:observationPlan ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:class v:ObservationPlan ] .

v:ObservationPlanShape a sh:NodeShape ;
  sh:targetClass v:ObservationPlan ;
  sh:property [ sh:path v:forElement ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v:Element ] ;
  sh:property [ sh:path v:usesProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v:ObservationProfile ] ;
  sh:property [ sh:path v:focus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:limit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:observedAt ; sh:minCount 1 ; sh:class v:Instrumentation ] ;
  sh:property [ sh:path v:scenario ; sh:minCount 1 ; sh:class v:Scenario ] ;
  sh:property [ sh:path v:tracesTo ; sh:minCount 1 ; sh:class v:RequirementSection ] ;
  sh:property [ sh:path v:governedBy ; sh:minCount 1 ;
    sh:or ( [ sh:class v:Invariant ] [ sh:class v:ProgressObligation ] [ sh:class v:Assumption ] ) ] .

v:ObservationProfileShape a sh:NodeShape ;
  sh:targetClass v:ObservationProfile ;
  sh:property [ sh:path v:metricIntent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:eventIntent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:logIntent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:traceIntent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:latencyQuestion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:trafficQuestion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:errorQuestion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:saturationQuestion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

# A valid but wrong-family instrumentation point must not satisfy release intent.
v:ReleaseObservationFamilyShape a sh:NodeShape ;
  sh:targetNode v:OBS-IF-02, v:OBS-IF-08, v:OBS-INV-08, v:OBS-INV-09, v:OBS-ID-13 ;
  sh:property [ sh:path v:observedAt ; sh:hasValue v:INS-03 ] .

# Argument/evidence structure, not automatic truth or certification.
v:AssuranceClaimShape a sh:NodeShape ;
  sh:targetClass v:AssuranceClaim ;
  sh:property [ sh:path v:claimKind ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ("BoundedSafety" "FiniteStateSafety" "ConditionalTemporal") ] ;
  sh:property [ sh:path v:claimText ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:argument ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:conditions ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:limit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path v:scopedBy ; sh:minCount 1 ; sh:class v:ProofSlice ] ;
  sh:property [ sh:path v:governedBy ; sh:minCount 1 ;
    sh:or ( [ sh:class v:Invariant ] [ sh:class v:ProgressObligation ] ) ] ;
  sh:property [ sh:path v:assumes ; sh:minCount 1 ; sh:class v:Assumption ] ;
  sh:property [ sh:path v:scenario ; sh:minCount 1 ; sh:class v:Scenario ] ;
  sh:property [ sh:path v:tracesTo ; sh:minCount 1 ; sh:class v:RequirementSection ] ;
  sh:property [ sh:path v:supportedBy ; sh:minCount 1 ; sh:class v:AssuranceSupport ] ;
  sh:property [ sh:path v:challengedBy ; sh:minCount 1 ; sh:class v:ProofCheck ] ;
  sh:property [ sh:path v:witnessedBy ; sh:minCount 1 ; sh:class v:ProofCheck ] .
v:AssuranceSupportShape a sh:NodeShape ;
  sh:targetClass v:AssuranceSupport ;
  sh:property [ sh:path v:evidenceCheck ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v:ProofCheck ] ;
  sh:property [ sh:path v:propertyName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
