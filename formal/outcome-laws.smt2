; D05 conditional projection/retention laws, not a full result enum or policy engine.
(set-logic ALL)
(set-option :timeout 10000)
(declare-datatype View ((view (pub Int) (effect Int) (reasons (Array Int Bool)) (hint Int))))
(declare-const pa Int)
(declare-const pb Int)
(declare-const ea Int)
(declare-const eb Int)
(declare-const ha Int)
(declare-const hb Int)
(declare-const ra (Array Int Bool))
(declare-const rb (Array Int Bool))
(declare-const mask (Array Int Bool))
(declare-const showPub Bool)
(declare-const showEffect Bool)
(declare-const showHint Bool)
(define-fun visible ((r (Array Int Bool))) (Array Int Bool)
  ((_ map and) r mask))
(define-fun project ((p Int) (e Int) (r (Array Int Bool)) (h Int)) View
  (view (ite showPub p (- 1)) (ite showEffect e (- 1)) (visible r) (ite showHint h (- 1))))
(echo "OUT-PROJECTION-NONINTERFERENCE")
(push)
(assert (and (=> showPub (= pa pb)) (=> showEffect (= ea eb))
  (=> showHint (= ha hb)) (= (visible ra) (visible rb))))
(check-sat)
(assert (distinct (project pa ea ra ha) (project pb eb rb hb)))
(check-sat)
(pop)
(echo "OUT-FILTER-IDEMPOTENCE")
(push)
(assert (= (visible ra) (visible ra)))
(check-sat)
(assert (distinct (visible (visible ra)) (visible ra)))
(check-sat)
(pop)
(declare-const currentGrant Bool)
(declare-const currentEpoch Int)
(declare-const capturedEpoch Int)
(declare-const sameRecipient Bool)
(define-fun release () Bool (and currentGrant (= currentEpoch capturedEpoch) sameRecipient))
(echo "OUT-CURRENT-RELEASE-GATE")
(push)
(assert (or (not currentGrant) (distinct currentEpoch capturedEpoch) (not sameRecipient)))
(check-sat)
(assert release)
(check-sat)
(pop)
(declare-const ownerPublication Int)
(declare-const observationFailed Bool)
(define-fun ownerAfter () Int ownerPublication)
(echo "OUT-OBSERVATION-FRAME")
(push)
(assert observationFailed)
(check-sat)
(assert (distinct ownerAfter ownerPublication))
(check-sat)
(pop)
(declare-const retryBasisVerified Bool)
(declare-const recoveryVisible Bool)
(define-fun protectedRetryHint () Bool (and retryBasisVerified recoveryVisible))
(echo "OUT-RECOVERY-BASIS-GATE")
(push)
(assert (not retryBasisVerified))
(check-sat)
(assert protectedRetryHint)
(check-sat)
(pop)
(echo "OUT-RAW-REASON-CONTROL")
(push)
(assert (and (= (visible ra) (visible rb)) (distinct ra rb)))
(check-sat)
(pop)
(echo "OUT-HIDDEN-TOP-KIND-CONTROL")
(push)
(assert (and (not showPub) (distinct pa pb)))
(assert (distinct (view pa (- 1) (visible ra) (- 1)) (view pb (- 1) (visible ra) (- 1))))
(check-sat)
(pop)
(echo "OUT-UNAVAILABLE-NONAPPLICATION-CONTROL")
(push)
; Numeric 1 is a private stand-in for an applied milestone; denial cannot negate it.
(assert (and (not currentGrant) (= ownerPublication 1)))
(check-sat)
(pop)
(echo "OUT-REASON-RETRY-CONTROL")
(push)
(assert (and (select ra 0) (not retryBasisVerified) (not protectedRetryHint)))
(check-sat)
(pop)
