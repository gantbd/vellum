; Conditional accounting laws, not actual allocation/provider/authority proofs.
(set-logic ALL)
(set-option :timeout 10000)
(declare-const cap Int)
(declare-const originCap Int)
(declare-const used Int)
(declare-const originUsed Int)
(declare-const demand Int)
(declare-const actual Int)
(declare-const actualExtra Int)
(declare-const released Int)
(declare-const actualAfter Int)
(declare-const targetUsed Int)
(declare-const targetCap Int)
(declare-const totalCap Int)
(declare-const spent Int)
(declare-const remaining Int)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(define-fun valid ((u Int) (c Int)) Bool (and (<= 0 u) (<= u c)))
(define-fun meet ((a Int) (b Int)) Int (ite (<= a b) a b))
(define-fun join ((a Int) (b Int)) Int (ite (<= a b) b a))

; One arbitrary resource coordinate, when one increment is charged to both scopes.
(echo "RES-ADMIT-PROFILE")
(push)
(assert (and (valid used cap) (valid originUsed originCap) (<= 0 demand)
  (<= demand (- cap used)) (<= demand (- originCap originUsed))))
(check-sat)
(assert (not (and (valid (+ used demand) cap)
  (valid (+ originUsed demand) originCap))))
(check-sat)
(pop)

; A real bound needs a truthful upper-bound relation, not a cost estimate.
(echo "RES-ACTUAL-REFINEMENT")
(push)
(assert (and (valid used cap) (<= 0 actual used)
  (<= 0 actualExtra demand) (<= demand (- cap used))))
(check-sat)
(assert (not (and (<= (+ actual actualExtra) (+ used demand))
  (<= (+ actual actualExtra) cap))))
(check-sat)
(pop)

; ActualAfter <= retained charge is a supplier/refinement premise, not derived
; from cancellation, expiry or caller completion.
(echo "RES-DISCHARGE")
(push)
(assert (and (valid used cap) (<= 0 released used)
  (<= 0 actualAfter (- used released))))
(check-sat)
(assert (not (and (valid (- used released) cap)
  (<= actualAfter (- used released)) (<= actualAfter cap))))
(check-sat)
(pop)

; Same-unit ownership transfer; recipient admission and rights remain premises.
(echo "RES-TRANSFER")
(push)
(assert (and (valid used cap) (valid targetUsed targetCap)
  (<= (+ used targetUsed) totalCap)
  (<= 0 demand used) (<= (+ targetUsed demand) targetCap)))
(check-sat)
(assert (not (and (valid (- used demand) cap)
  (valid (+ targetUsed demand) targetCap)
  (<= (+ (- used demand) (+ targetUsed demand)) totalCap)
  (= (+ (- used demand) (+ targetUsed demand)) (+ used targetUsed)))))
(check-sat)
(pop)

; Induction step for a finite quota: descendants consume the same remainder.
(echo "RES-QUOTA-STEP")
(push)
(assert (and (<= 0 spent) (<= 0 remaining) (= cap (+ spent remaining))
  (<= 0 demand remaining)))
(check-sat)
(assert (not (and (= cap (+ (+ spent demand) (- remaining demand)))
  (<= 0 (- remaining demand) remaining) (<= (+ spent demand) cap))))
(check-sat)
(pop)

; A finite product follows pointwise for a fixed finite coordinate set/capacity.
; This is not a lattice of executions, clocks, authority or the whole editor.
(echo "RES-PRODUCT-LATTICE")
(push)
(assert (and (valid x cap) (valid y cap)))
(check-sat)
(assert (not (and (valid (meet x y) cap) (valid (join x y) cap)
  (<= (meet x y) x) (<= (meet x y) y)
  (<= x (join x y)) (<= y (join x y))
  (=> (and (<= z x) (<= z y)) (<= z (meet x y)))
  (=> (and (<= x z) (<= y z)) (<= (join x y) z))
  (= (meet x (join x y)) x) (= (join x (meet x y)) x)
  (= (meet x cap) x) (= (join x 0) x))))
(check-sat)
(pop)

(echo "RES-MISSING-DIMENSION-CONTROL")
(push)
; A scheduling-cost ceiling holds while a different resource is over capacity.
(assert (and (valid used cap) (> actual originCap) (<= 0 originCap)))
(check-sat)
(pop)
(echo "RES-EARLY-RELEASE-CONTROL")
(push)
(assert (and (valid used cap) (<= 0 released used) (> released 0)
  (= actualAfter used) (> actualAfter (- used released))))
(check-sat)
(pop)
(echo "RES-FANOUT-CONTROL")
(push)
; Independent copies of the same parent remainder permit oversubscription.
(assert (and (> remaining 0) (<= 0 demand remaining) (> (+ demand demand) remaining)))
(check-sat)
(pop)
(echo "RES-TRANSFER-FORGET-CONTROL")
(push)
; Sender debit with no recipient charge loses aggregate accounting.
(assert (and (valid used cap) (valid targetUsed targetCap) (<= 0 demand used)
  (> demand 0) (< (+ (- used demand) targetUsed) (+ used targetUsed))))
(check-sat)
(pop)

; Conditional lifetime-origin induction. The bridge premise is that each encoded
; origin key fits the already-validated complete-request byte bound. This is not
; a JavaScript compiler, allocator or whole-owner refinement proof.
(declare-const replayCount Int)
(declare-const replayLimit Int)
(declare-const keyBound Int)
(declare-const originBytes Int)
(declare-const keyBytes Int)
(declare-const liveCeiling Int)
(declare-const combinedLimit Int)
(echo "RES-SPENT-ORIGIN-STEP")
(push)
(assert (and (<= 0 replayCount) (< replayCount replayLimit)
  (<= 0 keyBound) (<= 0 originBytes (* replayCount keyBound))
  (<= 0 keyBytes keyBound) (<= 0 liveCeiling)
  (= combinedLimit (+ liveCeiling (* replayLimit keyBound)))
  (<= combinedLimit 9007199254740991)))
(check-sat)
(assert (not (and
  (<= (+ originBytes keyBytes) (* replayLimit keyBound))
  (<= (+ liveCeiling originBytes keyBytes) combinedLimit))))
(check-sat)
(pop)

(echo "RES-SPENT-ORIGIN-OMITTED-CONTROL")
(push)
; No live task need remain when consumed origins exceed the payload-only ceiling.
(assert (and (= replayCount 128) (= replayLimit 128) (= keyBound 16384)
  (= originBytes 386432) (= liveCeiling 350000) (= combinedLimit liveCeiling)
  (<= originBytes (* replayCount keyBound)) (> originBytes combinedLimit)))
(check-sat)
(pop)
