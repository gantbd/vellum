; Abstract editor contracts, not upstream-editor or implementation verification.
; Each positive checks satisfiable premises then UNSAT negated conclusion.
; See precedent-proofs.md for induction, encoding correspondence and open gates.
(set-logic ALL)
(set-option :timeout 10000)

; PA-01: a fresh root stores a new immutable participant vector.
(declare-const roots (Array Int (Array Int Int)))
(declare-const oldRoot Int)
(declare-const newRoot Int)
(declare-const candidate (Array Int Int))
(declare-const participant Int)
(declare-const otherRoot Int)
(define-fun publishedRoots () (Array Int (Array Int Int)) (store roots newRoot candidate))
(echo "PRE-SNAPSHOT-PUBLISH")
(push)
(assert (distinct newRoot oldRoot))
(assert (distinct otherRoot newRoot))
(check-sat)
(assert (not (and (= (select publishedRoots oldRoot) (select roots oldRoot))
  (= (select publishedRoots otherRoot) (select roots otherRoot))
  (= (select (select publishedRoots newRoot) participant) (select candidate participant)))))
(check-sat)
(pop)
(echo "PRE-SNAPSHOT-REUSE-CONTROL")
(push)
(assert (= newRoot oldRoot))
(assert (distinct (select candidate participant) (select (select roots oldRoot) participant)))
(assert (distinct (select (select publishedRoots oldRoot) participant)
  (select (select roots oldRoot) participant)))
(check-sat)
(pop)

; PA-02: arbitrary sequence segments provide the finite-list induction step.
(declare-const prefix (Seq Int))
(declare-const gap (Seq Int))
(declare-const removed (Seq Int))
(declare-const inserted (Seq Int))
(declare-const suffix (Seq Int))
(define-fun splice ((s (Seq Int)) (l Int) (h Int) (x (Seq Int))) (Seq Int)
  (seq.++ (seq.extract s 0 l) x (seq.extract s h (- (seq.len s) h))))
(define-fun stagedSource () (Seq Int) (seq.++ prefix gap removed suffix))
(define-fun nextPrefix () (Seq Int) (seq.++ prefix gap inserted))
(define-fun stepLo () Int (+ (seq.len prefix) (seq.len gap)))
(define-fun stepHi () Int (+ stepLo (seq.len removed)))
(echo "PRE-BATCH-PREFIX-STEP")
(push)
(check-sat)
(assert (not (and
  (= (splice stagedSource stepLo stepHi inserted) (seq.++ nextPrefix suffix))
  (= (seq.len (splice stagedSource stepLo stepHi inserted))
     (+ (seq.len stagedSource) (seq.len inserted) (- (seq.len removed)))))))
(check-sat)
(pop)
(echo "PRE-BATCH-INVERSE-STEP")
(push)
(check-sat)
(assert (distinct
  (splice (seq.++ nextPrefix suffix) stepLo (+ stepLo (seq.len inserted)) removed)
  stagedSource))
(check-sat)
(pop)
(echo "PRE-BATCH-UNSHIFTED-CONTROL")
(push)
(declare-const obsoletePrefix (Seq Int))
(assert (distinct (seq.len obsoletePrefix) (seq.len prefix)))
(assert (<= (+ (seq.len obsoletePrefix) (seq.len gap) (seq.len removed)) (seq.len stagedSource)))
(assert (distinct (splice stagedSource (+ (seq.len obsoletePrefix) (seq.len gap))
  (+ (seq.len obsoletePrefix) (seq.len gap) (seq.len removed)) inserted)
  (splice stagedSource stepLo stepHi inserted)))
(check-sat)
(pop)

; PA-03: complete identity keys, not a numeric attachment ID alone.
(declare-datatypes () ((AttachmentKey (attachmentKey (namespace Int) (localId Int)))))
(declare-const marks (Array AttachmentKey Int))
(declare-const nsA Int)
(declare-const nsB Int)
(declare-const markId Int)
(declare-const otherId Int)
(declare-const position Int)
(echo "PRE-NAMESPACE-FRAME")
(push)
(assert (distinct nsA nsB))
(check-sat)
(assert (distinct (select (store marks (attachmentKey nsA markId) position)
  (attachmentKey nsB otherId)) (select marks (attachmentKey nsB otherId))))
(check-sat)
(pop)
(echo "PRE-NAMESPACE-ID-ONLY-CONTROL")
(push)
(declare-const idOnly (Array Int Int))
(assert (distinct nsA nsB))
(assert (distinct position (select idOnly markId)))
(assert (distinct (select (store idOnly markId position) markId) (select idOnly markId)))
(check-sat)
(pop)
(declare-const anchorN Int)
(declare-const insertionAt Int)
(declare-const insertionSize Int)
(declare-const startPoint Int)
(declare-const endPoint Int)
(declare-const startRight Bool)
(declare-const endRight Bool)
(define-fun mapAnchor ((p Int) (right Bool)) Int
  (ite (or (> p insertionAt) (and (= p insertionAt) right)) (+ p insertionSize) p))
(define-fun anchorPremises () Bool (and (<= 0 insertionAt) (<= insertionAt anchorN)
  (<= 0 insertionSize) (<= 0 startPoint) (<= startPoint endPoint) (<= endPoint anchorN)))
(echo "PRE-ANCHOR-RANGE-ORDER")
(push)
(assert anchorPremises)
(assert (or (< startPoint endPoint) (not startRight) endRight))
(check-sat)
(assert (not (and (<= 0 (mapAnchor startPoint startRight))
  (<= (mapAnchor startPoint startRight) (mapAnchor endPoint endRight))
  (<= (mapAnchor endPoint endRight) (+ anchorN insertionSize)))))
(check-sat)
(pop)
(echo "PRE-ANCHOR-OPPOSED-AFFINITY-CONTROL")
(push)
(assert anchorPremises)
(assert (and (= startPoint endPoint) (= startPoint insertionAt)
  startRight (not endRight) (> insertionSize 0)))
(assert (> (mapAnchor startPoint startRight) (mapAnchor endPoint endRight)))
(check-sat)
(pop)

; PA-04: one captured root chooses all participants, including unchanged ones.
(declare-const accepted Bool)
(declare-const readerRoot Int)
(define-fun liveRoot () Int (ite accepted newRoot oldRoot))
(echo "PRE-ATOMIC-ROOT-READ")
(push)
(assert (distinct oldRoot newRoot))
(assert (or (= readerRoot oldRoot) (= readerRoot liveRoot)))
(check-sat)
(assert (not (and
  (=> (= readerRoot newRoot)
    (= (select (select publishedRoots readerRoot) participant) (select candidate participant)))
  (=> (= readerRoot oldRoot)
    (= (select (select publishedRoots readerRoot) participant)
       (select (select roots oldRoot) participant))))))
(check-sat)
(pop)
(echo "PRE-ATOMIC-ABORT-FRAME")
(push)
(assert (not accepted))
(check-sat)
(assert (distinct liveRoot oldRoot))
(check-sat)
(pop)
(echo "PRE-ATOMIC-TORN-READ-CONTROL")
(push)
(declare-const otherParticipant Int)
(assert (distinct participant otherParticipant))
(assert (distinct (select candidate participant) (select (select roots oldRoot) participant)))
(assert (distinct (select candidate otherParticipant) (select (select roots oldRoot) otherParticipant)))
(declare-const torn (Array Int Int))
(assert (= torn (store (select roots oldRoot) participant (select candidate participant))))
(assert (and (distinct torn candidate) (distinct torn (select roots oldRoot))))
(check-sat)
(pop)

; PA-05: arbitrary-size group prefix. Group identity includes plan identity;
; time/coincident context cannot merge unrelated linked plans.
(declare-datatypes () ((GroupKey (groupKey (author Int) (plan Int) (context Int)))))
(declare-const groupEntries (Array Int GroupKey))
(declare-const groupSize Int)
(declare-const groupIdentity GroupKey)
(declare-const incoming GroupKey)
(declare-const groupClosed Bool)
(declare-const requestedJoin Bool)
(declare-const j Int)
(define-fun joins () Bool (and requestedJoin (not groupClosed) (= incoming groupIdentity)))
(define-fun nextSize () Int (ite joins (+ groupSize 1) groupSize))
(define-fun nextEntries () (Array Int GroupKey)
  (ite joins (store groupEntries groupSize incoming) groupEntries))
(echo "PRE-GROUP-APPEND-STEP")
(push)
(assert (>= groupSize 0))
(assert (and (<= 0 j) (< j nextSize)))
(assert (=> (< j groupSize) (= (select groupEntries j) groupIdentity)))
(check-sat)
(assert (distinct (select nextEntries j) groupIdentity))
(check-sat)
(pop)
(echo "PRE-GROUP-CLOSE-STABLE")
(push)
(assert (and (>= groupSize 0) groupClosed))
(check-sat)
(assert (not (and (= nextSize groupSize) (= nextEntries groupEntries))))
(check-sat)
(pop)
(echo "PRE-GROUP-PLAN-OMITTED-CONTROL")
(push)
(assert (and (= (author incoming) (author groupIdentity))
  (= (context incoming) (context groupIdentity))
  (distinct (plan incoming) (plan groupIdentity)) requestedJoin (not groupClosed)))
(assert (not joins))
(check-sat)
(pop)

; PA-06: typed canonical requests, not a frozen concrete command catalog.
(declare-const registered Bool)
(declare-const currentRevision Bool)
(declare-const authorized Bool)
(declare-const discovered Bool)
(declare-const commandRoot Int)
(declare-const commandCandidate Int)
(define-fun eligible () Bool (and registered currentRevision authorized))
(define-fun dispatch ((state Int) (candidateRoot Int) (ok Bool)) Int
  (ite ok candidateRoot state))
(echo "PRE-COMMAND-REJECT-FRAME")
(push)
(assert (not eligible))
(check-sat)
(assert (distinct (dispatch commandRoot commandCandidate eligible) commandRoot))
(check-sat)
(pop)
(echo "PRE-COMMAND-SURFACE-EQUIVALENCE")
(push)
(declare-const uiCandidate Int)
(declare-const agentCandidate Int)
(declare-const uiEligible Bool)
(declare-const agentEligible Bool)
(assert (and (= uiCandidate agentCandidate) (= uiEligible agentEligible)))
(check-sat)
(assert (distinct (dispatch commandRoot uiCandidate uiEligible)
  (dispatch commandRoot agentCandidate agentEligible)))
(check-sat)
(pop)
(echo "PRE-COMMAND-DISCOVERY-AUTHORITY-CONTROL")
(push)
(assert (and registered currentRevision discovered (not authorized)
  (distinct commandRoot commandCandidate)))
(assert (distinct (dispatch commandRoot commandCandidate discovered)
  (dispatch commandRoot commandCandidate eligible)))
(check-sat)
(pop)

; PA-07: independent contiguous regions; source contents are arbitrary.
(declare-const source (Array Int Int))
(declare-const regionALo Int)
(declare-const regionAHi Int)
(declare-const regionBLo Int)
(declare-const regionBHi Int)
(declare-const offsetA Int)
(declare-const offsetB Int)
(declare-const byteValue Int)
(declare-const delimiter Int)
(define-fun regionPremises () Bool (and (<= 0 regionALo) (<= regionALo regionAHi)
  (<= regionAHi regionBLo) (<= regionBLo regionBHi)
  (<= 0 offsetA) (< offsetA (- regionAHi regionALo))
  (<= 0 offsetB) (< offsetB (- regionBHi regionBLo))))
(define-fun regionUpdate () (Array Int Int) (store source (+ regionALo offsetA) byteValue))
(echo "PRE-REGION-INDEPENDENT-FRAME")
(push)
(assert regionPremises)
(assert (or (< delimiter regionALo) (>= delimiter regionAHi)))
(check-sat)
(assert (not (and
  (= (select regionUpdate (+ regionBLo offsetB)) (select source (+ regionBLo offsetB)))
  (= (select regionUpdate delimiter) (select source delimiter))
  (= (- (+ regionALo offsetA) regionALo) offsetA))))
(check-sat)
(pop)
(echo "PRE-REGION-CONCATENATION-CONTROL")
(push)
(assert regionPremises)
(assert (< regionAHi regionBLo))
; Treating concatenated virtual text as ONE contiguous interval hits the gap.
(assert (distinct (+ regionALo (- regionAHi regionALo) offsetB) (+ regionBLo offsetB)))
(check-sat)
(pop)
(echo "PRE-REGION-UNIQUE-MEMBERSHIP")
(push)
(assert (and (<= 0 regionALo) (<= regionALo regionAHi)
  (<= regionAHi regionBLo) (<= regionBLo regionBHi)))
(check-sat)
(assert (and (<= regionALo position) (< position regionAHi)
  (<= regionBLo position) (< position regionBHi)))
(check-sat)
(pop)
(echo "PRE-REGION-SPLICE-SUFFIX")
(push)
(check-sat)
; A replacement before a later region shifts that region's source origin,
; but the entire original suffix is unchanged. Identity still needs context.
(assert (distinct
  (seq.extract (splice stagedSource stepLo stepHi inserted)
    (+ stepLo (seq.len inserted)) (seq.len suffix)) suffix))
(check-sat)
(pop)

; PA-08: per-key resolver and declared dependency relation are parameters.
(declare-const config (Array Int Int))
(declare-const additions (Array Int Int))
(declare-const changed (Array Int Bool))
(declare-fun combine (Int Int Int) Int)
(declare-const key Int)
(declare-const consumerAffected Bool)
(declare-const consumerUsesKey Bool)
(define-fun nextConfig ((k Int)) Int
  (ite (select changed k) (combine k (select config k) (select additions k)) (select config k)))
(echo "PRE-CONFIG-UNRELATED-SETTING-FRAME")
(push)
(assert (not (select changed key)))
(check-sat)
(assert (distinct (nextConfig key) (select config key)))
(check-sat)
(pop)
(echo "PRE-CONFIG-DEPENDENCY-FRAME")
(push)
; This is the pointwise dependency-completeness premise, not its validator.
(assert (=> (and consumerUsesKey (select changed key)) consumerAffected))
(assert (and consumerUsesKey (not consumerAffected)))
(check-sat)
(assert (distinct (nextConfig key) (select config key)))
(check-sat)
(pop)
(echo "PRE-CONFIG-MISSING-DEPENDENCY-CONTROL")
(push)
(assert (and consumerUsesKey (select changed key) (not consumerAffected)))
(assert (distinct (nextConfig key) (select config key)))
(check-sat)
(pop)

; PA-09: accepted historical evidence for a FIXED captured effect attempt.
; Written and Synced are observations, not physical storage truth.
(declare-datatypes () ((SyncEvent NoReceipt WriteReceipt SyncReceipt SyncFailure)))
(declare-const event SyncEvent)
(declare-const acceptedReceipt Bool)
(declare-const writtenFact Bool)
(declare-const syncReceiptFact Bool)
(declare-const syncFailedFact Bool)
(define-fun syncedFact () Bool (and writtenFact syncReceiptFact))
(define-fun writtenNext () Bool (or writtenFact
  (and acceptedReceipt (= event WriteReceipt))))
(define-fun syncReceiptNext () Bool (or syncReceiptFact
  (and acceptedReceipt (= event SyncReceipt))))
(define-fun syncedNext () Bool (and writtenNext syncReceiptNext))
(define-fun failedNext () Bool (or syncFailedFact
  (and acceptedReceipt (= event SyncFailure))))
(echo "PRE-SYNC-EVIDENCE-STEP")
(push)
(check-sat)
(assert (not (and (=> syncedNext writtenNext)
  (=> writtenFact writtenNext) (=> syncedFact syncedNext)
  (=> syncReceiptFact syncReceiptNext)
  (=> syncFailedFact failedNext))))
(check-sat)
(pop)
(echo "PRE-SYNC-FAILURE-PRESERVES-WRITE")
(push)
(assert (and writtenFact (not syncedFact) acceptedReceipt (= event SyncFailure)))
(check-sat)
(assert (not (and writtenNext (not syncedNext) failedNext)))
(check-sat)
(pop)
(echo "PRE-SYNC-OUTOFORDER-RETAINED")
(push)
(assert (and (not writtenFact) (not syncReceiptFact) acceptedReceipt (= event SyncReceipt)))
(check-sat)
(assert (not (and (not writtenNext) syncReceiptNext (not syncedNext))))
(check-sat)
(pop)
(echo "PRE-SYNC-PREMATURE-ACK-CONTROL")
(push)
(assert (and writtenFact (not syncedFact) (= event NoReceipt)))
(assert (and writtenNext (not syncedNext)))
(check-sat)
(pop)
