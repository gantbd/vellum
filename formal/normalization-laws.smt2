; Local ordering/frame lemmas, not a concrete parser or arbitrary-list refinement.
(set-logic ALL)
(set-option :timeout 10000)
(declare-datatype Edit ((edit (lo Int) (hi Int) (payload Int) (metadata Int) (expected Int) (context Int))))
(declare-datatype Pair ((pair (first Edit) (second Edit))))
(declare-const a Edit)
(declare-const b Edit)
(declare-const n Int)
(define-fun ordered ((x Edit) (y Edit)) Bool
  (and (< (lo x) (lo y)) (<= (hi x) (lo y))
    (=> (= (hi x) (lo y)) (and (< (lo x) (hi x)) (< (lo y) (hi y))))))
(define-fun valid () Bool (and (<= 0 (lo a) (hi a) n) (<= 0 (lo b) (hi b) n)
  (or (ordered a b) (ordered b a))))
(define-fun norm ((x Edit) (y Edit)) Pair (ite (<= (lo x) (lo y)) (pair x y) (pair y x)))
(echo "NRM-TWO-IDEMPOTENT")
(push)
(assert valid)
(check-sat)
(assert (distinct (norm (first (norm a b)) (second (norm a b))) (norm a b)))
(check-sat)
(pop)
(echo "NRM-TWO-PERMUTATION")
(push)
(assert valid)
(check-sat)
(assert (distinct (norm a b) (norm b a)))
(check-sat)
(pop)
(echo "NRM-RECORD-FRAME")
(push)
(assert valid)
(check-sat)
(assert (not (and (ordered (first (norm a b)) (second (norm a b)))
  (or (= (norm a b) (pair a b)) (= (norm a b) (pair b a)))
  (= (metadata (first (norm a b))) (ite (< (lo a) (lo b)) (metadata a) (metadata b)))
  (= (expected (second (norm a b))) (ite (< (lo a) (lo b)) (expected b) (expected a)))
  (= (context (first (norm a b))) (ite (< (lo a) (lo b)) (context a) (context b))))))
(check-sat)
(pop)
(declare-const left Int)
(declare-const boundary Int)
(declare-const right Int)
(declare-const leftInsert Int)
(declare-const rightInsert Int)
(define-fun mapPoint ((p Int) (l Int) (h Int) (k Int)) Int
  (ite (<= p l) p (ite (>= p h) (+ p k (- l h)) (- 1))))
(echo "NRM-ADJACENT-MAP-SEPARATION")
(push)
(assert (and (<= 0 left) (< left boundary right) (<= 0 leftInsert) (<= 0 rightInsert)))
(check-sat)
(assert (not (and
  (= (mapPoint (mapPoint boundary boundary right rightInsert) left boundary leftInsert) (+ left leftInsert))
  (= (mapPoint boundary left right (+ leftInsert rightInsert)) (- 1))
  (distinct (mapPoint (mapPoint boundary boundary right rightInsert) left boundary leftInsert)
    (mapPoint boundary left right (+ leftInsert rightInsert))))))
(check-sat)
(pop)
(echo "NRM-INPUT-ORDER-CONTROL")
(push)
(assert valid)
(assert (> (lo a) (lo b)))
(assert (distinct (pair a b) (norm a b)))
(check-sat)
(pop)
(echo "NRM-METADATA-SWAP-CONTROL")
(push)
(assert valid)
(assert (< (lo a) (lo b)))
(assert (distinct (metadata a) (metadata b)))
(assert (distinct (norm a b)
  (pair (edit (lo a) (hi a) (payload a) (metadata b) (expected a) (context a))
        (edit (lo b) (hi b) (payload b) (metadata a) (expected b) (context b)))))
(check-sat)
(pop)
(echo "NRM-TIE-ORDER-CONTROL")
(push)
(assert (= (lo a) (lo b)))
(assert (distinct a b))
(assert (distinct (norm a b) (norm b a)))
(check-sat)
(pop)
