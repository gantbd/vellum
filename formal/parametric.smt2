; Parametric verification conditions, NOT a concrete implementation proof.
; Every positive obligation checks satisfiable premises before refuting its
; negated conclusion. Z3 is trusted; no independent proof-kernel replay claimed.
(set-logic ALL)
(set-option :timeout 10000)
(declare-const B Int)
(declare-const n Int)
(declare-const fuel Int)
(declare-const stop Bool)

(echo "SMT-RANK-BASE")
(push)
(assert (> B 0))
(assert (= n 0))
(assert (= fuel B))
(check-sat)
(assert (not (and (>= n 0) (> fuel 0) (= (+ n fuel) B))))
(check-sat)
(pop)

; Adopted source-change laws over arbitrary valid integer boundary domains.
; These do not encode Unicode segmentation, allocation or a concrete tree.
(declare-const sourceLen Int)
(declare-const editLo Int)
(declare-const editHi Int)
(declare-const insertLen Int)
(declare-const point Int)
(define-fun editPremise () Bool (and (>= sourceLen 0) (>= editLo 0)
  (<= editLo editHi) (<= editHi sourceLen) (>= insertLen 0)))
(define-fun delta () Int (- insertLen (- editHi editLo)))
(define-fun resultLen () Int (+ sourceLen delta))
(define-fun mappedPoint () Int (ite (<= point editLo) point
  (ite (>= point editHi) (+ point delta) (- 1))))
(echo "SMT-EDIT-LENGTH")
(push)
(assert editPremise)
(check-sat)
(assert (not (and (>= resultLen 0) (<= editLo resultLen)
  (<= (+ editLo insertLen) resultLen)
  (= (+ (- resultLen insertLen) (- editHi editLo)) sourceLen))))
(check-sat)
(pop)

(echo "SMT-EDIT-POINT-DOMAIN")
(push)
(assert editPremise)
(assert (and (>= point 0) (<= point sourceLen)))
(check-sat)
(assert (not (or (= mappedPoint (- 1))
  (and (>= mappedPoint 0) (<= mappedPoint resultLen)))))
(check-sat)
(pop)

(echo "SMT-EDIT-SURVIVOR-ROUNDTRIP")
(push)
(assert editPremise)
(assert (and (>= point 0) (<= point sourceLen)))
; Replacement-interior and collapsed end-boundary identity are NOT asserted.
(assert (or (<= point editLo) (> point editHi)))
(check-sat)
(define-fun inversePoint () Int (ite (<= mappedPoint editLo) mappedPoint
  (ite (>= mappedPoint (+ editLo insertLen)) (- mappedPoint delta) (- 1))))
(assert (not (= inversePoint point)))
(check-sat)
(pop)

(echo "SMT-EDIT-SCOPE-FRAME")
(push)
(declare-const scopeLo Int)
(declare-const scopeHi Int)
(assert editPremise)
(assert (and (>= scopeLo 0) (<= scopeLo editLo)
  (<= editHi scopeHi) (<= scopeHi sourceLen)))
(check-sat)
(assert (not (and (<= scopeLo editLo)
  (<= (+ editLo insertLen) (+ scopeHi delta))
  (<= (+ scopeHi delta) resultLen)
  (= (- sourceLen scopeHi) (- resultLen (+ scopeHi delta))))))
(check-sat)
(pop)

(echo "SMT-EDIT-COLLAPSED-TARGET-CONTROL")
(push)
(assert (and editPremise (< editLo editHi) (= insertLen 0) (= point editHi)))
; The endpoint maps onto the start after deletion; coordinate survival alone
; cannot prove original identity. This counterexample MUST remain satisfiable.
(assert (= mappedPoint editLo))
(assert (distinct mappedPoint point))
(check-sat)
(pop)

(echo "SMT-RANK-STEP")
(push)
(assert (> B 0))
(assert (>= n 0))
(assert (> fuel 0))
(assert (<= (+ n fuel) B))
(check-sat)
; An active transition consumes one unit; at zero it must stop control.
(define-fun nextFuel () Int (- fuel 1))
(define-fun nextN () Int (+ n 1))
(define-fun terminal () Bool (or stop (= nextFuel 0)))
(define-fun nextRank () Int (ite terminal 0 nextFuel))
(assert (not (and (>= nextFuel 0) (<= (+ nextN nextFuel) B)
  (<= nextN B) (>= nextRank 0) (< nextRank fuel)
  (=> (not terminal) (> nextFuel 0)))))
(check-sat)
(pop)

(echo "SMT-RANK-NO-REFILL-CONTROL")
(push)
(assert (> fuel 0))
; Omitting consumption admits a non-decreasing active step.
(assert (>= fuel fuel))
(check-sat)
(pop)

; Pointwise membership of arbitrary sets: equality of predicates is extensional
; set equality. No bound on the underlying observation universe is imposed.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const universe Bool)
(echo "SMT-LATTICE-LAWS")
(push)
(assert (and (=> a universe) (=> b universe) (=> c universe)))
(check-sat)
(assert (not (and
  (= (or a b) (or b a)) (= (and a b) (and b a))
  (= (or a (or b c)) (or (or a b) c))
  (= (and a (and b c)) (and (and a b) c))
  (= (or a a) a) (= (and a a) a)
  (= (or a (and a b)) a) (= (and a (or a b)) a)
  (= (or a false) a) (= (and a universe) a)
  (=> (or a b) universe) (=> (and a b) universe)
  (=> a (or a b)) (=> b (or a b))
  (=> (and a b) a) (=> (and a b) b)
  (=> (and (=> a c) (=> b c)) (=> (or a b) c))
  (=> (and (=> c a) (=> c b)) (=> c (and a b))))))
(check-sat)
(pop)

; Arbitrarily indexed family, including an empty selected subfamily.
(declare-sort Index 0)
(declare-sort Atom 0)
(declare-fun selected (Index) Bool)
(declare-fun member (Index Atom) Bool)
(declare-fun F (Atom) Bool)
(declare-fun U (Atom) Bool)
(declare-fun L (Atom) Bool)
(declare-const x Atom)
(declare-const i Index)
(echo "SMT-JOIN-CLOSURE")
(push)
(assert (forall ((j Index) (v Atom)) (=> (and (selected j) (member j v)) (F v))))
(check-sat)
(assert (exists ((j Index)) (and (selected j) (member j x))))
(assert (not (F x)))
(check-sat)
(pop)

(echo "SMT-JOIN-UPPER")
(push)
(assert (selected i))
(assert (member i x))
(check-sat)
(assert (not (exists ((j Index)) (and (selected j) (member j x)))))
(check-sat)
(pop)

(echo "SMT-JOIN-LEAST")
(push)
(assert (forall ((j Index) (v Atom)) (=> (and (selected j) (member j v)) (U v))))
(check-sat)
(assert (exists ((j Index)) (and (selected j) (member j x))))
(assert (not (U x)))
(check-sat)
(pop)

(echo "SMT-MEET-LOWER")
(push)
(assert (selected i))
(assert (F x))
(assert (forall ((j Index)) (=> (selected j) (member j x))))
(check-sat)
(assert (not (member i x)))
(check-sat)
(pop)

(echo "SMT-MEET-GREATEST")
(push)
(assert (forall ((v Atom)) (=> (L v) (F v))))
(assert (forall ((j Index) (v Atom)) (=> (and (selected j) (L v)) (member j v))))
(assert (L x))
(check-sat)
(assert (not (and (F x) (forall ((j Index)) (=> (selected j) (member j x))))))
(check-sat)
(pop)

(echo "SMT-EMPTY-FAMILY-BOUNDS")
(push)
(assert (forall ((j Index)) (not (selected j))))
(check-sat)
(assert (or (exists ((j Index)) (and (selected j) (member j x)))
  (not (= (and (F x) (forall ((j Index)) (=> (selected j) (member j x)))) (F x)))))
(check-sat)
(pop)

; Parametric one-step simulation VC; mathematical induction then applies to
; finite traces of this deterministic public transition relation.
(declare-const publicL Int)
(declare-const publicR Int)
(declare-const input Int)
(declare-const hiddenStep Bool)
(declare-fun publicStep (Int Int) Int)
(declare-fun observe (Int) Int)
(echo "SMT-PROJECTION-PRESERVATION")
(push)
(assert (= publicL publicR))
(check-sat)
(assert (not (= (observe (ite hiddenStep publicL (publicStep publicL input)))
                (observe (ite hiddenStep publicR (publicStep publicR input))))))
(check-sat)
(pop)

(echo "SMT-HIDDEN-LEAK-CONTROL")
(push)
(declare-const hiddenL Int)
(declare-const hiddenR Int)
(assert (= publicL publicR))
(assert (distinct hiddenL hiddenR))
(assert (distinct (+ publicL hiddenL) (+ publicR hiddenR)))
(check-sat)
(pop)

(echo "SMT-CLOSURE-RANK")
(push)
(declare-const total Int)
(declare-const oldSize Int)
(declare-const newSize Int)
(assert (and (>= oldSize 0) (< oldSize newSize) (<= newSize total)))
(check-sat)
(assert (not (and (>= (- total newSize) 0) (< (- total newSize) (- total oldSize)))))
(check-sat)
(pop)

; Pre/post composition is conditional on both component contracts.
(declare-sort State 0)
(declare-fun Pre (State) Bool)
(declare-fun Mid (State) Bool)
(declare-fun Post (State) Bool)
(declare-fun First (State State) Bool)
(declare-fun Second (State State) Bool)
(declare-const s State)
(declare-const t State)
(declare-const u State)
(echo "SMT-CONTRACT-COMPOSITION")
(push)
(assert (forall ((p State) (q State)) (=> (and (Pre p) (First p q)) (Mid q))))
(assert (forall ((p State) (q State)) (=> (and (Mid p) (Second p q)) (Post q))))
(assert (and (Pre s) (First s t) (Second t u)))
(check-sat)
(assert (not (Post u)))
(check-sat)
(pop)

(echo "SMT-MISSING-BRIDGE-CONTROL")
(push)
(assert (forall ((p State) (q State)) (=> (and (Pre p) (First p q)) (Mid q))))
; No guarantee connects Mid to Second's Post.
(assert (and (Pre s) (First s t) (Second t u) (not (Post u))))
(check-sat)
(pop)

; Shared-root frame conditions corresponding to the narrow bridge profile.
; This is an authored encoding, not an automatic translation of Bridges.tla.
(declare-datatypes () ((BridgeRoot (mkBridgeRoot
  (brTextA Int) (brTextB Int) (brRevA Int) (brRevB Int)
  (brUndoA Bool) (brUndoB Bool) (brBody Int) (brBodyVersion Int)
  (brLocated Bool) (brMappedRev Int) (brGeneration Int)))))
(declare-datatypes () ((BridgePublic (mkBridgePublic
  (bpTextA Int) (bpTextB Int) (bpRevA Int) (bpRevB Int)))))
(declare-const br BridgeRoot)
(declare-const br2 BridgeRoot)
(declare-const newText Int)
(declare-const newBody Int)
(define-fun SourceUpdate ((r BridgeRoot) (v Int)) BridgeRoot
  (mkBridgeRoot v v (+ (brRevA r) 1) (+ (brRevB r) 1)
    (= v 1) (= v 1) (brBody r) (brBodyVersion r) false
    (+ (brRevA r) 1) (+ (brGeneration r) 1)))
(define-fun CommentUpdate ((r BridgeRoot) (v Int)) BridgeRoot
  (mkBridgeRoot (brTextA r) (brTextB r) (brRevA r) (brRevB r)
    (brUndoA r) (brUndoB r) v (+ (brBodyVersion r) 1)
    (brLocated r) (brMappedRev r) (+ (brGeneration r) 1)))
(define-fun SafePublic ((r BridgeRoot)) BridgePublic
  (mkBridgePublic (brTextA r) (brTextB r) (brRevA r) (brRevB r)))
(echo "SMT-BRIDGE-SOURCE-FRAME")
(push)
(assert (= (brRevA br) (brRevB br)))
(assert (or (= newText 0) (= newText 1)))
(check-sat)
(assert (not (let ((r (SourceUpdate br newText))) (and
  (= (brBody r) (brBody br)) (= (brBodyVersion r) (brBodyVersion br))
  (= (brUndoA r) (= (brTextA r) 1)) (= (brUndoB r) (= (brTextB r) 1))
  (= (brRevA r) (+ (brRevA br) 1)) (= (brRevB r) (+ (brRevB br) 1))
  (= (brMappedRev r) (brRevA r)) (not (brLocated r))))))
(check-sat)
(pop)

(echo "SMT-BRIDGE-COMMENT-FRAME")
(push)
(check-sat)
(assert (not (let ((r (CommentUpdate br newBody))) (and
  (= (SafePublic r) (SafePublic br))
  (= (brUndoA r) (brUndoA br)) (= (brUndoB r) (brUndoB br))
  (= (brMappedRev r) (brMappedRev br)) (= (brLocated r) (brLocated br))))))
(check-sat)
(pop)

(echo "SMT-BRIDGE-PUBLIC-ERASURE")
(push)
(assert (= (brTextA br) (brTextA br2)))
(assert (= (brTextB br) (brTextB br2)))
(assert (= (brRevA br) (brRevA br2)))
(assert (= (brRevB br) (brRevB br2)))
(check-sat)
(assert (not (= (SafePublic br) (SafePublic br2))))
(check-sat)
(pop)

; A fresh, non-reused version changes at every successful conditional write.
; This is stronger than opaque content-validator equality.
(declare-const expectedVersion Int)
(declare-const afterFirst Int)
(declare-const atSecond Int)
(echo "SMT-SAVE-CAS-SINGLE-WINNER")
(push)
(assert (= afterFirst (+ expectedVersion 1)))
(assert (>= atSecond afterFirst))
(check-sat)
(assert (= atSecond expectedVersion))
(check-sat)
(pop)

; Associative/idempotent merge of trusted order evidence, not arrival clocks.
(define-fun maxOrder ((p Int) (q Int)) Int (ite (>= p q) p q))
(declare-const orderA Int)
(declare-const orderB Int)
(declare-const orderC Int)
(echo "SMT-SAVE-ORDER-MERGE")
(push)
(assert (and (>= orderA 0) (>= orderB 0) (>= orderC 0)))
(check-sat)
(assert (not (and
  (= (maxOrder orderA orderB) (maxOrder orderB orderA))
  (= (maxOrder orderA (maxOrder orderB orderC)) (maxOrder (maxOrder orderA orderB) orderC))
  (= (maxOrder orderA orderA) orderA)
  (>= (maxOrder orderA orderB) orderA) (>= (maxOrder orderA orderB) orderB))))
(check-sat)
(pop)

(echo "SMT-SAVE-ABA-CONTROL")
(push)
(declare-const token0 Int)
(declare-const token1 Int)
(declare-const token2 Int)
(assert (and (= token0 0) (= token1 1) (= token2 0)))
; Two writes occurred, but token equality would accept the original precondition
; again and could fabricate a backwards causal edge from write 2 to write 1.
(assert (= token2 token0))
(assert (distinct token1 token0))
(check-sat)
(pop)

; Two storage executions with identical accepted local observations/receipts
; but different final data under reusable equality tokens. The second includes
; one unobserved foreign write. Only overlap (not conservative single-flight)
; permits Old to remain outstanding while New is dispatched.
(declare-datatypes () ((SaveStore (mkSaveStore (ssToken Int) (ssData Int)))))
(define-fun casAccepted ((r SaveStore) (expected Int)) Bool (= (ssToken r) expected))
(define-fun casSave ((r SaveStore) (expected Int) (data Int)) SaveStore
  (ite (casAccepted r expected) (mkSaveStore data data) r))
(echo "SMT-SAVE-OPAQUE-AMBIGUITY-CONTROL")
(push)
(declare-const storage0 SaveStore)
(assert (= storage0 (mkSaveStore 0 0)))
; World A: Old writes 1; Probe sees 1; New writes 0.
(declare-const aOld SaveStore)
(declare-const aNew SaveStore)
(assert (casAccepted storage0 0))
(assert (= aOld (casSave storage0 0 1)))
(assert (casAccepted aOld 1))
(assert (= aNew (casSave aOld 1 0)))
; World B: Foreign writes 1; Probe sees 1; New writes 0; Old writes 1.
(declare-const bForeign SaveStore)
(declare-const bNew SaveStore)
(declare-const bOld SaveStore)
(assert (= bForeign (mkSaveStore 1 1)))
(assert (casAccepted bForeign 1))
(assert (= bNew (casSave bForeign 1 0)))
(assert (casAccepted bNew 0))
(assert (= bOld (casSave bNew 0 1)))
; Same Probe and successful receipt tokens, in the same delivered order New,Old.
(assert (= (ssToken aOld) (ssToken bForeign)))
(assert (= (ssToken aNew) (ssToken bNew)))
(assert (= (ssToken aOld) (ssToken bOld)))
(assert (distinct (ssData aNew) (ssData bOld)))
(check-sat)
(pop)

; Arbitrary-length source arrays: equality is checked pointwise at an arbitrary
; in-range index. No finite source alphabet/length bound is used here.
(declare-const textA (Array Int Int))
(declare-const insertA (Array Int Int))
(declare-const insertB (Array Int Int))
(declare-const textN Int)
(declare-const loA Int)
(declare-const hiA Int)
(declare-const lenA Int)
(declare-const indexA Int)
(define-fun textPremise () Bool (and (>= textN 0) (>= loA 0)
  (<= loA hiA) (<= hiA textN) (>= lenA 0)))
(define-fun spliceValue ((src (Array Int Int)) (ins (Array Int Int))
    (lo Int) (hi Int) (k Int) (j Int)) Int
  (ite (< j lo) (select src j)
    (ite (< j (+ lo k)) (select ins (- j lo))
      (select src (+ (- j k) (- hi lo))))))
(define-fun splicedArray ((src (Array Int Int)) (ins (Array Int Int))
    (lo Int) (hi Int) (k Int)) (Array Int Int)
  (lambda ((j Int)) (spliceValue src ins lo hi k j)))
(define-fun deletedArray () (Array Int Int)
  (lambda ((j Int)) (select textA (+ loA j))))
(echo "SMT-TEXT-INVERSE-CONTENT")
(push)
(assert textPremise)
(assert (and (>= indexA 0) (< indexA textN)))
(check-sat)
(assert (distinct (spliceValue (splicedArray textA insertA loA hiA lenA)
  deletedArray loA (+ loA lenA) (- hiA loA) indexA) (select textA indexA)))
(check-sat)
(pop)

(echo "SMT-TEXT-PREFIX-SUFFIX-FRAME")
(push)
(assert textPremise)
(assert (and (>= indexA 0) (< indexA (+ textN lenA (- loA hiA)))))
(check-sat)
(assert (not (and
  (=> (< indexA loA) (= (spliceValue textA insertA loA hiA lenA indexA)
    (select textA indexA)))
  (=> (>= indexA (+ loA lenA))
    (= (spliceValue textA insertA loA hiA lenA indexA)
       (select textA (+ indexA (- hiA loA) (- lenA))))))))
(check-sat)
(pop)

(declare-const loB Int)
(declare-const hiB Int)
(declare-const lenB Int)
(define-fun batchPremise () Bool (and textPremise (< hiA loB)
  (<= loB hiB) (<= hiB textN) (>= lenB 0)))
(define-fun deltaA () Int (- lenA (- hiA loA)))
(define-fun deltaB () Int (- lenB (- hiB loB)))
(define-fun rightThenLeft () Int
  (spliceValue (splicedArray textA insertB loB hiB lenB)
    insertA loA hiA lenA indexA))
(define-fun leftThenShifted () Int
  (spliceValue (splicedArray textA insertA loA hiA lenA)
    insertB (+ loB deltaA) (+ hiB deltaA) lenB indexA))
(echo "SMT-TEXT-BATCH-COMPOSITION")
(push)
(assert batchPremise)
(assert (and (>= indexA 0) (< indexA (+ textN deltaA deltaB))))
(check-sat)
(assert (distinct rightThenLeft leftThenShifted))
(check-sat)
(pop)

(echo "SMT-TEXT-UNSHIFTED-BATCH-CONTROL")
(push)
(assert batchPremise)
(assert (and (>= indexA 0) (< indexA (+ textN deltaA deltaB))))
(assert (distinct rightThenLeft
  (spliceValue (splicedArray textA insertA loA hiA lenA)
    insertB loB hiB lenB indexA)))
(check-sat)
(pop)

; PA-02: extend the strict-gap theorem to adjacent NONEMPTY source ranges.
; Arbitrary lengths/content, pointwise equality over the entire result domain.
; Does not choose coincident insertion ordering or prove many-edit refinement.
(echo "SMT-TEXT-ADJACENT-COMPOSITION")
(push)
(assert (and textPremise (< loA hiA) (= hiA loB)
  (< loB hiB) (<= hiB textN) (>= lenB 0)))
(assert (and (>= indexA 0) (< indexA (+ textN deltaA deltaB))))
(check-sat)
(assert (not (and
  (>= (+ loB deltaA) 0)
  (<= (+ hiB deltaA) (+ textN deltaA))
  (= rightThenLeft leftThenShifted))))
(check-sat)
(pop)

(echo "SMT-TEXT-ADJACENT-UNSHIFTED-CONTROL")
(push)
(assert (and textPremise (< loA hiA) (= hiA loB)
  (< loB hiB) (<= hiB textN) (>= lenB 0)))
(assert (and (>= indexA 0) (< indexA (+ textN deltaA deltaB))))
(assert (distinct rightThenLeft
  (spliceValue (splicedArray textA insertA loA hiA lenA)
    insertB loB hiB lenB indexA)))
(check-sat)
(pop)

; PA-03: explicit LEFT/RIGHT affinity at a pure insertion. Deleted identities
; and replacement-interior anchors have a separate, still-unselected profile.
(declare-const rightAffinity Bool)
(define-fun insertionPoint () Int
  (ite (or (> point editLo) (and (= point editLo) rightAffinity))
    (+ point insertLen) point))
(echo "SMT-ANCHOR-INSERTION-AFFINITY")
(push)
(assert (and editPremise (= editLo editHi) (<= 0 point) (<= point sourceLen)))
(check-sat)
(assert (not (and (<= 0 insertionPoint) (<= insertionPoint resultLen)
  (=> (< point editLo) (= insertionPoint point))
  (=> (> point editLo) (= insertionPoint (+ point insertLen)))
  (=> (= point editLo)
    (= insertionPoint (ite rightAffinity (+ editLo insertLen) editLo))))))
(check-sat)
(pop)

(echo "SMT-ANCHOR-IGNORED-AFFINITY-CONTROL")
(push)
(assert (and editPremise (= editLo editHi) (= point editLo)
  rightAffinity (> insertLen 0)))
(assert (distinct point insertionPoint))
(check-sat)
(pop)

; PA-01: functional update preserves the retained array value. This establishes
; value semantics only, not the lifetime/aliasing of any actual Rust allocation.
(declare-const updateAt Int)
(declare-const updateValue Int)
(declare-const nextArray (Array Int Int))
(echo "SMT-SNAPSHOT-FUNCTIONAL-FRAME")
(push)
(assert (= nextArray (store textA updateAt updateValue)))
(check-sat)
(assert (not (and (= (select nextArray updateAt) updateValue)
  (=> (distinct indexA updateAt) (= (select nextArray indexA) (select textA indexA))))))
(check-sat)
(pop)

(echo "SMT-SNAPSHOT-ALIASED-WRITE-CONTROL")
(push)
(assert (= nextArray (store textA updateAt updateValue)))
(assert (distinct updateValue (select textA updateAt)))
; Rebinding an old snapshot handle to the new value would expose changed text.
(assert (distinct (select nextArray updateAt) (select textA updateAt)))
(check-sat)
(pop)

; PA-05: grouping legality uses the semantic group key, NOT elapsed time alone.
; History reversal/frontier/retention remain separate temporal-model obligations.
(declare-const authorA Int)
(declare-const authorB Int)
(declare-const intentA Int)
(declare-const intentB Int)
(declare-const contextA Int)
(declare-const contextB Int)
(declare-const closeInTime Bool)
(declare-const groupingEnabled Bool)
(declare-const isolated Bool)
(define-fun mayCoalesce () Bool (and groupingEnabled closeInTime (not isolated)
  (= authorA authorB) (= intentA intentB) (= contextA contextB)))
(echo "SMT-HISTORY-GROUP-ISOLATION")
(push)
(assert mayCoalesce)
(check-sat)
(assert (not (and (= authorA authorB) (= intentA intentB)
  (= contextA contextB) (not isolated))))
(check-sat)
(pop)

(echo "SMT-HISTORY-TIMER-ONLY-CONTROL")
(push)
(assert (and groupingEnabled closeInTime (distinct authorA authorB)))
(assert (not mayCoalesce))
(check-sat)
(pop)

; PA-08: two dependent context components, arbitrary compatibility relation.
; No grammar compatibility oracle, schema or retention limit is proved here.
(declare-fun compatible (Int Int) Bool)
(declare-const oldGrammar Int)
(declare-const oldQuery Int)
(declare-const newGrammar Int)
(declare-const newQuery Int)
(declare-const installCandidate Bool)
(define-fun activeGrammar () Int (ite installCandidate newGrammar oldGrammar))
(define-fun activeQuery () Int (ite installCandidate newQuery oldQuery))
(echo "SMT-CONTEXT-COHERENT-ACTIVATION")
(push)
(assert (and (compatible oldGrammar oldQuery)
  (=> installCandidate (compatible newGrammar newQuery))))
(check-sat)
(assert (not (compatible activeGrammar activeQuery)))
(check-sat)
(pop)

(echo "SMT-CONTEXT-PARTIAL-ACTIVATION-CONTROL")
(push)
(assert (and (compatible oldGrammar oldQuery) (compatible newGrammar newQuery)
  (not (compatible newGrammar oldQuery))))
(check-sat)
(pop)

(declare-const chunkCut Int)
(define-fun chunkLeft () (Array Int Int) textA)
(define-fun chunkRight () (Array Int Int)
  (lambda ((j Int)) (select textA (+ chunkCut j))))
(define-fun chunkRead ((j Int)) Int
  (ite (< j chunkCut) (select chunkLeft j) (select chunkRight (- j chunkCut))))
(echo "SMT-TEXT-CHUNK-READ-REFINEMENT")
(push)
(assert (and (>= textN 0) (>= chunkCut 0) (<= chunkCut textN)
  (>= indexA 0) (< indexA textN)))
(check-sat)
(assert (distinct (chunkRead indexA) (select textA indexA)))
(check-sat)
(pop)

(echo "SMT-TEXT-CHUNK-OFFSET-CONTROL")
(push)
(assert (and (> textN 1) (> chunkCut 0) (< chunkCut textN)
  (>= indexA chunkCut) (< indexA textN)))
(assert (distinct (select chunkRight indexA) (select textA indexA)))
(check-sat)
(pop)

; Region mapping is a source interval, not ownership transfer or a semantic
; claim about the grammar. Only the identity/affine region profile is encoded.
(declare-const regionLo Int)
(declare-const regionHi Int)
(declare-const regionPoint Int)
(echo "SMT-REGION-SOURCE-MAP")
(push)
(assert (and (>= regionLo 0) (<= regionLo regionHi) (<= regionHi textN)
  (>= regionPoint 0) (<= regionPoint (- regionHi regionLo))))
(check-sat)
(assert (not (and (>= (+ regionLo regionPoint) regionLo)
  (<= (+ regionLo regionPoint) regionHi)
  (= (- (+ regionLo regionPoint) regionLo) regionPoint))))
(check-sat)
(pop)

; RFC 3629 scalar encoding/decoding. No normalization, grapheme, shaping or
; Unicode-property database is inferred from validity of the byte encoding.
(define-fun scalar ((u Int)) Bool
  (and (<= 0 u) (<= u 1114111) (or (< u 55296) (> u 57343))))
(define-fun utfWidth ((u Int)) Int
  (ite (< u 128) 1 (ite (< u 2048) 2 (ite (< u 65536) 3 4))))
(define-fun enc0 ((u Int)) Int
  (ite (= (utfWidth u) 1) u (ite (= (utfWidth u) 2) (+ 192 (div u 64))
    (ite (= (utfWidth u) 3) (+ 224 (div u 4096)) (+ 240 (div u 262144))))))
(define-fun enc1 ((u Int)) Int
  (+ 128 (mod (div u (ite (= (utfWidth u) 2) 1
    (ite (= (utfWidth u) 3) 64 4096))) 64)))
(define-fun enc2 ((u Int)) Int
  (+ 128 (mod (div u (ite (= (utfWidth u) 3) 1 64)) 64)))
(define-fun enc3 ((u Int)) Int (+ 128 (mod u 64)))
(define-fun cont ((b Int)) Bool (and (<= 128 b) (<= b 191)))
(define-fun leadByte ((b Int)) Bool
  (or (and (<= 0 b) (<= b 127)) (and (<= 194 b) (<= b 244))))
(define-fun utfValid ((w Int) (b0 Int) (b1 Int) (b2 Int) (b3 Int)) Bool
  (or (and (= w 1) (<= 0 b0) (<= b0 127))
    (and (= w 2) (<= 194 b0) (<= b0 223) (cont b1))
    (and (= w 3) (cont b2)
      (or (and (= b0 224) (<= 160 b1) (<= b1 191))
        (and (<= 225 b0) (<= b0 236) (cont b1))
        (and (= b0 237) (<= 128 b1) (<= b1 159))
        (and (<= 238 b0) (<= b0 239) (cont b1))))
    (and (= w 4) (cont b2) (cont b3)
      (or (and (= b0 240) (<= 144 b1) (<= b1 191))
        (and (<= 241 b0) (<= b0 243) (cont b1))
        (and (= b0 244) (<= 128 b1) (<= b1 143))))))
(define-fun utfDecode ((w Int) (b0 Int) (b1 Int) (b2 Int) (b3 Int)) Int
  (ite (= w 1) b0 (ite (= w 2) (+ (* (- b0 192) 64) (- b1 128))
    (ite (= w 3) (+ (* (- b0 224) 4096) (* (- b1 128) 64) (- b2 128))
      (+ (* (- b0 240) 262144) (* (- b1 128) 4096)
        (* (- b2 128) 64) (- b3 128))))))
(declare-const unicodeScalar Int)
(echo "SMT-UTF8-SCALAR-ROUNDTRIP")
(push)
(assert (scalar unicodeScalar))
(check-sat)
(assert (distinct (utfDecode (utfWidth unicodeScalar) (enc0 unicodeScalar)
  (enc1 unicodeScalar) (enc2 unicodeScalar) (enc3 unicodeScalar)) unicodeScalar))
(check-sat)
(pop)

(echo "SMT-UTF8-ENCODING-VALIDITY")
(push)
(assert (scalar unicodeScalar))
(check-sat)
(assert (not (utfValid (utfWidth unicodeScalar) (enc0 unicodeScalar)
  (enc1 unicodeScalar) (enc2 unicodeScalar) (enc3 unicodeScalar))))
(check-sat)
(pop)

(declare-const byteWidth Int)
(declare-const byte0 Int)
(declare-const byte1 Int)
(declare-const byte2 Int)
(declare-const byte3 Int)
(define-fun decodedScalar () Int (utfDecode byteWidth byte0 byte1 byte2 byte3))
(echo "SMT-UTF8-DECODE-SCALAR")
(push)
(assert (utfValid byteWidth byte0 byte1 byte2 byte3))
(check-sat)
(assert (not (scalar decodedScalar)))
(check-sat)
(pop)

(echo "SMT-UTF8-CANONICAL-REENCODE")
(push)
(assert (utfValid byteWidth byte0 byte1 byte2 byte3))
(check-sat)
(assert (not (and (= (utfWidth decodedScalar) byteWidth)
  (= (enc0 decodedScalar) byte0)
  (=> (>= byteWidth 2) (= (enc1 decodedScalar) byte1))
  (=> (>= byteWidth 3) (= (enc2 decodedScalar) byte2))
  (=> (= byteWidth 4) (= (enc3 decodedScalar) byte3)))))
(check-sat)
(pop)

(echo "SMT-UTF8-CONTINUATION-NOT-LEAD")
(push)
(assert (and (utfValid byteWidth byte0 byte1 byte2 byte3)
  (<= 2 byteWidth)))
(check-sat)
(assert (or (and (<= 2 byteWidth) (leadByte byte1))
  (and (<= 3 byteWidth) (leadByte byte2))
  (and (= 4 byteWidth) (leadByte byte3))))
(check-sat)
(pop)

(echo "SMT-UTF8-SURROGATE-CONTROL")
(push)
; Removing the restricted ED second byte admits a surrogate code point.
(assert (and (= byteWidth 3) (= byte0 237) (cont byte1) (cont byte2)
  (not (scalar decodedScalar))))
(check-sat)
(pop)

(echo "SMT-UTF8-OVERLONG-CONTROL")
(push)
; Removing the C2 lower bound admits noncanonical ASCII encodings.
(assert (and (= byteWidth 2) (= byte0 192) (cont byte1)
  (< decodedScalar 128)))
(check-sat)
(pop)

(echo "SMT-UTF8-OUT-OF-RANGE-CONTROL")
(push)
; Removing the F4 upper second-byte bound admits values beyond U+10FFFF.
(assert (and (= byteWidth 4) (= byte0 244) (cont byte1) (cont byte2) (cont byte3)
  (> decodedScalar 1114111)))
(check-sat)
(pop)

; Arbitrary nonnegative ledger quantities and a finite-backlog rank. These are
; algebraic premises, not an automatic induction/refinement of the TLA modules.
(declare-const ledgerCreated Int)
(declare-const ledgerDischarged Int)
(declare-const ledgerHeld Int)
(declare-const ledgerAdd Int)
(declare-const ledgerRelease Int)
(define-fun ledgerPremise () Bool (and
  (>= ledgerCreated 0) (>= ledgerDischarged 0) (>= ledgerHeld 0)
  (= ledgerCreated (+ ledgerDischarged ledgerHeld))
  (>= ledgerAdd 0) (>= ledgerRelease 0)
  (<= ledgerRelease (+ ledgerHeld ledgerAdd))))
(echo "SMT-LEDGER-CONSERVATION")
(push)
(assert ledgerPremise)
(check-sat)
(assert (not (and
  (= (+ ledgerCreated ledgerAdd)
    (+ ledgerDischarged ledgerRelease (- (+ ledgerHeld ledgerAdd) ledgerRelease)))
  (>= (- (+ ledgerHeld ledgerAdd) ledgerRelease) 0))))
(check-sat)
(pop)
(echo "SMT-LEDGER-OMITTED-DISCHARGE-CONTROL")
(push)
(assert (and ledgerPremise (> ledgerRelease 0)))
(assert (not (= (+ ledgerCreated ledgerAdd)
  (+ ledgerDischarged (- (+ ledgerHeld ledgerAdd) ledgerRelease)))))
(check-sat)
(pop)
(echo "SMT-DRAIN-RANK")
(push)
(assert (> ledgerHeld 0))
(check-sat)
(assert (not (and (>= (- ledgerHeld 1) 0) (< (- ledgerHeld 1) ledgerHeld))))
(check-sat)
(pop)
(echo "SMT-DRAIN-NO-SERVICE-CONTROL")
(push)
(assert (and (> ledgerHeld 0) (not (< ledgerHeld ledgerHeld))))
(check-sat)
(pop)
(declare-const privacyPublic Int)
(declare-const privacyHiddenL Int)
(declare-const privacyHiddenR Int)
(define-fun privacyMask ((public Int) (hidden Int)) Int public)
(echo "SMT-PRIVACY-PROJECTION")
(push)
(assert (distinct privacyHiddenL privacyHiddenR))
(check-sat)
(assert (distinct (privacyMask privacyPublic privacyHiddenL)
                 (privacyMask privacyPublic privacyHiddenR)))
(check-sat)
(pop)
(echo "SMT-PRIVACY-TAG-CONTROL")
(push)
(assert (distinct privacyHiddenL privacyHiddenR))
(assert (distinct (+ privacyPublic privacyHiddenL) (+ privacyPublic privacyHiddenR)))
(check-sat)
(pop)
